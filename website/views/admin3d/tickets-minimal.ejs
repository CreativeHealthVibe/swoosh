<%# Minimalist Ticket Management Interface %>

<style>
  .minimal-container {
    max-width: 1000px;
    margin: 40px auto;
    padding: 20px;
    background: rgba(20, 20, 35, 0.7);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .server-selector {
    margin-bottom: 30px;
  }

  .server-selector select {
    width: 100%;
    padding: 12px 16px;
    background: rgba(25, 25, 40, 0.8);
    border: 1px solid rgba(120, 80, 200, 0.4);
    border-radius: 8px;
    color: #fff;
    font-size: 16px;
  }

  .tickets-content {
    display: none;
  }

  .ticket-actions {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
  }

  .btn {
    padding: 10px 16px;
    background: rgba(100, 80, 200, 0.6);
    border: none;
    border-radius: 6px;
    color: white;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn:hover {
    background: rgba(120, 100, 220, 0.8);
  }

  .ticket-list {
    width: 100%;
    border-collapse: collapse;
  }

  .ticket-list th {
    text-align: left;
    padding: 12px 16px;
    background: rgba(30, 30, 50, 0.6);
    color: #ddd;
    font-weight: 500;
  }

  .ticket-list tr {
    border-bottom: 1px solid rgba(80, 80, 120, 0.2);
  }

  .ticket-list tr:hover {
    background: rgba(80, 80, 120, 0.1);
  }

  .ticket-list td {
    padding: 12px 16px;
    color: #ccc;
  }

  /* Modals */
  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }

  .modal-inner {
    background: rgba(25, 25, 40, 0.95);
    width: 90%;
    max-width: 600px;
    border-radius: 8px;
    padding: 20px;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(100, 80, 200, 0.3);
  }

  .modal-title {
    font-size: 18px;
    color: #fff;
    margin: 0;
  }

  .modal-close {
    background: transparent;
    border: none;
    color: #999;
    font-size: 24px;
    cursor: pointer;
  }

  .modal-form {
    margin-bottom: 20px;
  }

  .form-group {
    margin-bottom: 16px;
  }

  .form-label {
    display: block;
    margin-bottom: 8px;
    color: #ccc;
  }

  .form-input {
    width: 100%;
    padding: 10px;
    background: rgba(30, 30, 50, 0.6);
    border: 1px solid rgba(100, 80, 200, 0.3);
    border-radius: 6px;
    color: #fff;
  }

  .form-textarea {
    width: 100%;
    height: 100px;
    resize: vertical;
    padding: 10px;
    background: rgba(30, 30, 50, 0.6);
    border: 1px solid rgba(100, 80, 200, 0.3);
    border-radius: 6px;
    color: #fff;
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 20px;
  }

  .btn-delete {
    background: rgba(220, 50, 80, 0.7);
  }

  .btn-delete:hover {
    background: rgba(240, 70, 100, 0.9);
  }

  .loading {
    text-align: center;
    padding: 40px 0;
    color: #999;
  }

  .spinner {
    border: 3px solid rgba(100, 80, 200, 0.3);
    border-top: 3px solid rgba(100, 80, 200, 0.8);
    border-radius: 50%;
    width: 30px;
    height: 30px;
    animation: spin 1s linear infinite;
    margin: 0 auto 20px;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<div class="minimal-container">
  <div class="server-selector">
    <select id="server-select">
      <option value="">Select a server</option>
      <% if (client && client.guilds) { %>
        <% client.guilds.cache.sort((a, b) => a.name.localeCompare(b.name)).forEach(guild => { %>
          <option value="<%= guild.id %>"><%= guild.name %> (<%= guild.memberCount %> members)</option>
        <% }); %>
      <% } %>
    </select>
  </div>

  <div id="tickets-content" class="tickets-content">
    <div class="ticket-actions">
      <button id="refresh-btn" class="btn">Refresh</button>
      <button id="create-panel-btn" class="btn">Create Ticket Panel</button>
      <button id="settings-btn" class="btn">Settings</button>
    </div>

    <table class="ticket-list">
      <thead>
        <tr>
          <th>ID</th>
          <th>User</th>
          <th>Topic</th>
          <th>Status</th>
          <th>Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="tickets-table">
        <tr>
          <td colspan="6">
            <div class="loading">
              <div class="spinner"></div>
              <p>Select a server to view tickets</p>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Ticket View Modal -->
<div id="view-modal" class="modal">
  <div class="modal-inner">
    <div class="modal-header">
      <h3 class="modal-title">Ticket Details</h3>
      <button class="modal-close">&times;</button>
    </div>
    <div id="ticket-details"></div>
    <div class="modal-footer">
      <button class="btn" id="download-transcript">Download Transcript</button>
      <button class="btn btn-delete" id="close-ticket">Close Ticket</button>
    </div>
  </div>
</div>

<!-- Close Ticket Modal -->
<div id="close-modal" class="modal">
  <div class="modal-inner">
    <div class="modal-header">
      <h3 class="modal-title">Close Ticket</h3>
      <button class="modal-close">&times;</button>
    </div>
    <div class="modal-form">
      <div class="form-group">
        <label class="form-label">Reason for closing</label>
        <textarea id="close-reason" class="form-textarea" placeholder="Provide a reason for closing this ticket"></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn" id="cancel-close">Cancel</button>
      <button class="btn btn-delete" id="confirm-close">Close Ticket</button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Elements
    const serverSelect = document.getElementById('server-select');
    const ticketsContent = document.getElementById('tickets-content');
    const ticketsTable = document.getElementById('tickets-table');
    const refreshBtn = document.getElementById('refresh-btn');
    const viewModal = document.getElementById('view-modal');
    const closeModal = document.getElementById('close-modal');
    const closeModalBtns = document.querySelectorAll('.modal-close');
    const closeTicketBtn = document.getElementById('close-ticket');
    const downloadBtn = document.getElementById('download-transcript');
    const cancelCloseBtn = document.getElementById('cancel-close');
    const confirmCloseBtn = document.getElementById('confirm-close');
    
    // Variables
    let currentServerId = '';
    let currentTicketId = '';
    let tickets = [];
    
    // Event listeners
    serverSelect.addEventListener('change', handleServerChange);
    refreshBtn.addEventListener('click', loadTickets);
    closeModalBtns.forEach(btn => btn.addEventListener('click', closeModals));
    closeTicketBtn.addEventListener('click', openCloseModal);
    cancelCloseBtn.addEventListener('click', closeModals);
    confirmCloseBtn.addEventListener('click', closeTicket);
    downloadBtn.addEventListener('click', downloadTranscript);
    
    /**
     * Handle server select change
     */
    function handleServerChange() {
      currentServerId = serverSelect.value;
      
      if (!currentServerId) {
        ticketsContent.style.display = 'none';
        return;
      }
      
      ticketsContent.style.display = 'block';
      loadTickets();
    }
    
    /**
     * Load tickets for the selected server
     */
    async function loadTickets() {
      if (!currentServerId) return;
      
      // Show loading
      ticketsTable.innerHTML = `
        <tr>
          <td colspan="6">
            <div class="loading">
              <div class="spinner"></div>
              <p>Loading tickets...</p>
            </div>
          </td>
        </tr>
      `;
      
      try {
        // Fetch tickets
        const response = await fetch(`/api/v2/servers/${currentServerId}/tickets`);
        const data = await response.json();
        
        if (!data.success) {
          throw new Error(data.message || 'Failed to load tickets');
        }
        
        tickets = data.tickets || [];
        
        // Render tickets
        if (tickets.length === 0) {
          ticketsTable.innerHTML = `
            <tr>
              <td colspan="6">
                <div class="loading">
                  <p>No tickets found for this server</p>
                </div>
              </td>
            </tr>
          `;
          return;
        }
        
        // Sort tickets (newest first)
        tickets.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
        
        // Build table
        let html = '';
        tickets.forEach(ticket => {
          const date = new Date(ticket.createdAt);
          const formatDate = `${date.toLocaleDateString()} ${date.toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'})}`;
          
          html += `
            <tr>
              <td>${ticket.id || '#' + ticket.number}</td>
              <td>${ticket.user ? ticket.user.username : 'Unknown'}</td>
              <td>${ticket.topic || 'No topic'}</td>
              <td>${ticket.status || 'Unknown'}</td>
              <td>${formatDate}</td>
              <td>
                <button class="btn view-ticket" data-id="${ticket.id}">View</button>
                ${ticket.status === 'Open' ? `<button class="btn btn-delete close-ticket" data-id="${ticket.id}">Close</button>` : ''}
              </td>
            </tr>
          `;
        });
        
        ticketsTable.innerHTML = html;
        
        // Add ticket action listeners
        document.querySelectorAll('.view-ticket').forEach(btn => {
          btn.addEventListener('click', () => viewTicket(btn.dataset.id));
        });
        
        document.querySelectorAll('.close-ticket').forEach(btn => {
          btn.addEventListener('click', () => {
            currentTicketId = btn.dataset.id;
            openCloseModal();
          });
        });
      } catch (error) {
        console.error('Error loading tickets:', error);
        ticketsTable.innerHTML = `
          <tr>
            <td colspan="6">
              <div class="loading">
                <p>Error: ${error.message}</p>
              </div>
            </td>
          </tr>
        `;
      }
    }
    
    /**
     * View ticket details
     * @param {string} ticketId - Ticket ID
     */
    async function viewTicket(ticketId) {
      currentTicketId = ticketId;
      
      const ticket = tickets.find(t => t.id === ticketId);
      if (!ticket) return;
      
      // Show view modal with loading
      viewModal.style.display = 'flex';
      document.getElementById('ticket-details').innerHTML = `
        <div class="loading">
          <div class="spinner"></div>
          <p>Loading ticket details...</p>
        </div>
      `;
      
      try {
        // Load transcript preview
        const response = await fetch(`/api/v2/servers/${currentServerId}/tickets/${ticketId}/transcript-preview`);
        const data = await response.json();
        
        if (!data.success) {
          throw new Error(data.message || 'Failed to load ticket details');
        }
        
        // Format date
        const date = new Date(ticket.createdAt);
        const formatDate = `${date.toLocaleDateString()} ${date.toLocaleTimeString()}`;
        
        // Build details HTML
        let html = `
          <div style="margin-bottom: 20px;">
            <p><strong>User:</strong> ${ticket.user ? ticket.user.username : 'Unknown'}</p>
            <p><strong>ID:</strong> ${ticket.id || '#' + ticket.number}</p>
            <p><strong>Created:</strong> ${formatDate}</p>
            <p><strong>Topic:</strong> ${ticket.topic || 'No topic'}</p>
            <p><strong>Status:</strong> ${ticket.status || 'Unknown'}</p>
          </div>
          
          <h4 style="margin-bottom: 10px;">Messages</h4>
        `;
        
        // Add messages
        const messages = data.messages || [];
        if (messages.length === 0) {
          html += `<p>No messages found in this ticket</p>`;
        } else {
          html += `<div style="max-height: 300px; overflow-y: auto; border: 1px solid rgba(100, 80, 200, 0.3); border-radius: 6px; padding: 10px;">`;
          
          messages.forEach(msg => {
            const msgDate = new Date(msg.timestamp);
            const msgTime = msgDate.toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'});
            
            html += `
              <div style="padding-bottom: 10px; margin-bottom: 10px; border-bottom: 1px solid rgba(100, 80, 200, 0.2);">
                <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                  <strong>${msg.author.username}</strong>
                  <span>${msgTime}</span>
                </div>
                <div>${msg.content}</div>
              </div>
            `;
          });
          
          html += `</div>`;
        }
        
        document.getElementById('ticket-details').innerHTML = html;
      } catch (error) {
        console.error('Error loading ticket details:', error);
        document.getElementById('ticket-details').innerHTML = `
          <div class="loading">
            <p>Error: ${error.message}</p>
          </div>
        `;
      }
    }
    
    /**
     * Open close ticket modal
     */
    function openCloseModal() {
      if (!currentTicketId) return;
      
      viewModal.style.display = 'none';
      closeModal.style.display = 'flex';
      document.getElementById('close-reason').value = '';
    }
    
    /**
     * Close all modals
     */
    function closeModals() {
      viewModal.style.display = 'none';
      closeModal.style.display = 'none';
    }
    
    /**
     * Download transcript
     */
    function downloadTranscript() {
      if (!currentTicketId || !currentServerId) return;
      
      const a = document.createElement('a');
      a.href = `/api/v2/servers/${currentServerId}/tickets/${currentTicketId}/transcript`;
      a.download = `transcript-${currentTicketId}.html`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }
    
    /**
     * Close the current ticket
     */
    async function closeTicket() {
      if (!currentTicketId || !currentServerId) return;
      
      const reason = document.getElementById('close-reason').value;
      
      try {
        confirmCloseBtn.disabled = true;
        confirmCloseBtn.innerText = 'Closing...';
        
        const response = await fetch(`/api/v2/servers/${currentServerId}/tickets/${currentTicketId}/close`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ reason })
        });
        
        const data = await response.json();
        
        if (!data.success) {
          throw new Error(data.message || 'Failed to close ticket');
        }
        
        // Close modals and refresh tickets
        closeModals();
        loadTickets();
      } catch (error) {
        console.error('Error closing ticket:', error);
        alert('Error closing ticket: ' + error.message);
      } finally {
        confirmCloseBtn.disabled = false;
        confirmCloseBtn.innerText = 'Close Ticket';
      }
    }
  });
</script>