<%# 
  SWOOSH Bot 3D Admin Dashboard
  Premium Edition
  
  Moderation management page with ban, warning, and automod tools
  COMPLETE REBUILD with reliable, direct ban access approach
%>

<div class="admin3d-moderation">
  <!-- Premium background layers -->
  <div class="premium-bg-layer">
    <div class="premium-bg-gradient gradient-1"></div>
    <div class="premium-bg-gradient gradient-2"></div>
    <div class="premium-bg-gradient gradient-3"></div>
    <div class="premium-bg-gradient gradient-4"></div>
    <div class="premium-bg-grid"></div>
  </div>
  
  <!-- Page header -->
  <div class="moderation-header">
    <h1 class="moderation-title">Ultra Premium Moderation Dashboard</h1>
    <p class="moderation-subtitle">Advanced tools with enhanced 3D visualization for comprehensive server management - featuring reliable direct ban access</p>
  </div>
  
  <!-- Server selector -->
  <div class="mod-server-selector">
    <span>Server:</span>
    <div class="server-selector-wrapper">
      <select id="serverSelect" class="admin3d-form-select">
        <option value="">Select a server</option>
        <% if (servers && servers.length > 0) { %>
          <% servers.forEach(server => { %>
            <option value="<%= server.id %>"><%= server.name %></option>
          <% }); %>
        <% } else { %>
          <option disabled>No servers available</option>
        <% } %>
      </select>
    </div>
    
    <!-- Emergency button -->
    <div class="emergency-tools">
      <a href="/admin3d/moderation-emergency" class="admin3d-btn admin3d-btn-danger emergency-link">
        <i class="fas fa-exclamation-triangle"></i> Emergency Tools
      </a>
    </div>
  </div>
  
  <!-- Stats Cards -->
  <div class="mod-stats-cards">
    <div class="mod-stat-card">
      <div class="mod-stat-icon ban-icon">
        <i class="fas fa-gavel"></i>
      </div>
      <div class="mod-stat-content">
        <h3 id="totalBans">0</h3>
        <span>Active Bans</span>
      </div>
    </div>
    
    <div class="mod-stat-card">
      <div class="mod-stat-icon warning-icon">
        <i class="fas fa-exclamation-triangle"></i>
      </div>
      <div class="mod-stat-content">
        <h3 id="totalWarnings">0</h3>
        <span>Active Warnings</span>
      </div>
    </div>
    
    <div class="mod-stat-card">
      <div class="mod-stat-icon shield-icon">
        <i class="fas fa-shield-alt"></i>
      </div>
      <div class="mod-stat-content">
        <h3 id="automodActions">0</h3>
        <span>AutoMod Actions</span>
      </div>
    </div>
    
    <div class="mod-stat-card">
      <div class="mod-stat-icon member-icon">
        <i class="fas fa-users"></i>
      </div>
      <div class="mod-stat-content">
        <h3 id="memberCount">0</h3>
        <span>Total Members</span>
      </div>
    </div>
  </div>
  
  <!-- Tabs Container -->
  <div class="tabs-container">
    <div class="admin3d-tabs">
      <button class="tab-btn active" data-tab="ban-management">
        <i class="fas fa-gavel"></i> Ban Management
      </button>
      <button class="tab-btn" data-tab="warning-system">
        <i class="fas fa-exclamation-triangle"></i> Warning System
      </button>
      <button class="tab-btn" data-tab="auto-moderation">
        <i class="fas fa-shield-alt"></i> Auto-Moderation
      </button>
      <button class="tab-btn" data-tab="advanced-filters">
        <i class="fas fa-filter"></i> Advanced Filters
      </button>
    </div>
    
    <!-- Fix for form interaction issues -->
    <style>
      /* Fix input interaction issues */
      .admin3d-form-input,
      .admin3d-form-textarea,
      .admin3d-form-select,
      .admin3d-btn {
        position: relative;
        z-index: 100 !important;
        pointer-events: auto !important;
      }
      
      /* Make sure forms are above the THREE.js canvas */
      .tab-content {
        position: relative;
        z-index: 50;
      }
      
      /* Ensure inputs can be interacted with */
      .admin3d-form-group,
      .form-field {
        position: relative;
        z-index: 100;
      }
      
      /* Ensure THREE.js doesn't block */
      #moderation-three-container {
        pointer-events: none !important;
        z-index: -1 !important;
      }
    </style>
  
  <!-- 3D Visualization Container -->
  <div id="moderation-three-container" class="moderation-three-container"></div>
  
  <!-- THREE.js library loading with fallbacks -->
  <script>
    // THREE.js loader with multiple CDN fallbacks
    function loadThreeJS() {
      const sources = [
        'https://cdn.jsdelivr.net/npm/three@0.151.0/build/three.min.js',
        'https://cdnjs.cloudflare.com/ajax/libs/three.js/151/three.min.js',
        'https://unpkg.com/three@0.151.0/build/three.min.js'
      ];
      
      function tryLoad(index) {
        if (index >= sources.length) {
          console.warn('THREE.js not loaded! Falling back to 2D mode.');
          // Tell the visualization to use 2D mode
          window.threeJSLoaded = false;
          return;
        }
        
        const script = document.createElement('script');
        script.src = sources[index];
        script.onload = function() {
          console.log(`THREE.js loaded successfully from ${sources[index]}`);
          window.threeJSLoaded = true;
        };
        script.onerror = function() {
          console.warn(`Failed to load THREE.js from ${sources[index]}`);
          document.body.removeChild(script);
          tryLoad(index + 1);
        };
        document.body.appendChild(script);
      }
      
      // Start trying to load THREE.js
      tryLoad(0);
    }
    
    // Load THREE.js when the page loads
    document.addEventListener('DOMContentLoaded', function() {
      loadThreeJS();
      initializeTabs();
    });
    
    // Initialize tab functionality
    function initializeTabs() {
      console.log('Initializing tabs...');
      const tabButtons = document.querySelectorAll('.tab-btn');
      const tabContents = document.querySelectorAll('.tab-content');
      
      // Debug which tabs exist
      tabButtons.forEach(btn => {
        console.log('Found tab button:', btn.getAttribute('data-tab'));
      });
      
      tabContents.forEach(content => {
        console.log('Found tab content ID:', content.id);
      });
      
      // Tab click event
      tabButtons.forEach(button => {
        button.addEventListener('click', function(e) {
          e.preventDefault();
          
          const tabId = this.getAttribute('data-tab');
          console.log('Tab clicked:', tabId);
          
          // Remove active class from all tabs
          tabButtons.forEach(btn => btn.classList.remove('active'));
          tabContents.forEach(content => {
            content.classList.remove('active');
            content.style.display = 'none';
          });
          
          // Add active class to clicked tab
          this.classList.add('active');
          const activeTab = document.getElementById(tabId);
          if (activeTab) {
            activeTab.classList.add('active');
            activeTab.style.display = 'block';
          } else {
            console.error('Could not find tab with id:', tabId);
          }
        });
      });
    }
  </script>
  
  <!-- Content Container -->
  <div class="tab-content-container">
    <!-- Tab Content -->
    <div class="tab-content-container">
      <!-- Ban Management Tab -->
      <div id="ban-management" class="tab-content active">
        <div class="mod-section mod-ban-section">
          <!-- Left section: Ban User -->
          <div class="mod-ban-user">
            <div class="mod-section-header">
              <div class="mod-section-icon">
                <i class="fas fa-user-slash"></i>
              </div>
              <h3>Ban User</h3>
              <div class="mod-premium-badge">
                <span>ULTRA</span>
              </div>
            </div>
            <div class="mod-section-content">
              <p class="mod-desc">Ban a user from your server with customizable options.</p>
              
              <!-- Ban User Form with Direct Submission -->
              <form action="/admin3d/direct-bans/ban-user" method="POST" id="banUserForm">
                <input type="hidden" id="banServerId" name="serverId" value="">
                
                <div class="admin3d-form-group">
                  <label class="admin3d-form-label" for="userId">User ID or @Mention</label>
                  <input class="admin3d-form-input" type="text" id="userId" name="userId" placeholder="Enter user ID or @mention" required>
                </div>
                
                <div class="admin3d-form-group">
                  <label class="admin3d-form-label" for="banReason">Reason</label>
                  <textarea class="admin3d-form-textarea" id="banReason" name="reason" placeholder="Explain the reason for this ban..." required rows="3"></textarea>
                </div>
                
                <div class="admin3d-form-row">
                  <div class="admin3d-form-group">
                    <label class="admin3d-form-label" for="banDuration">Duration</label>
                    <select class="admin3d-form-select" id="banDuration" name="duration">
                      <option value="permanent">Permanent</option>
                      <option value="1d">1 Day</option>
                      <option value="3d">3 Days</option>
                      <option value="7d">1 Week</option>
                      <option value="14d">2 Weeks</option>
                      <option value="30d">1 Month</option>
                      <option value="custom">Custom...</option>
                    </select>
                  </div>
                </div>
                
                <!-- Custom Duration Input (hidden by default) -->
                <div id="customDurationGroup" class="admin3d-form-group" style="display: none;">
                  <label class="admin3d-form-label" for="customDuration">Custom Duration</label>
                  <div class="custom-duration-inputs">
                    <input class="admin3d-form-input" type="number" id="customDuration" name="customDuration" min="1" value="1">
                    <select class="admin3d-form-select" id="customDurationUnit" name="customDurationUnit">
                      <option value="h">Hours</option>
                      <option value="d" selected>Days</option>
                      <option value="w">Weeks</option>
                      <option value="m">Months</option>
                    </select>
                  </div>
                </div>
                
                <div class="admin3d-form-options">
                  <div class="admin3d-form-check">
                    <input type="checkbox" id="deleteMessages" name="deleteMessages" value="true">
                    <label for="deleteMessages">Delete recent messages</label>
                  </div>
                  
                  <div class="admin3d-form-check">
                    <input type="checkbox" id="addToBlacklist" name="addToBlacklist" value="true">
                    <label for="addToBlacklist">Add to blacklist</label>
                  </div>
                </div>
                
                <div class="admin3d-form-actions">
                  <button type="submit" class="admin3d-btn admin3d-btn-danger" id="banUserBtn">
                    <i class="fas fa-gavel"></i> <span>Ban User</span>
                  </button>
                </div>
              </form>
            </div>
          </div>
          
          <!-- Right section: Current Bans -->
          <div class="mod-current-bans">
            <div class="mod-section-header">
              <div class="mod-section-icon list-icon">
                <i class="fas fa-list"></i>
              </div>
              <h3>Current Bans</h3>
              <div class="mod-refresh-btn" id="refreshBans">
                <i class="fas fa-sync-alt"></i>
              </div>
            </div>
            <div class="mod-section-content">
              <!-- Ban List Search -->
              <div class="admin3d-search-filters">
                <div class="admin3d-search-box">
                  <i class="fas fa-search"></i>
                  <input type="text" id="banSearchInput" placeholder="Search bans...">
                </div>
              </div>
              
              <!-- Ban List Table -->
              <div class="admin3d-table-wrapper">
                <table class="admin3d-table">
                  <thead>
                    <tr>
                      <th>User</th>
                      <th>Reason</th>
                      <th>Date</th>
                      <th>Duration</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="banListBody">
                    <tr class="empty-state">
                      <td colspan="5">
                        <div class="empty-state-message">
                          <i class="fas fa-info-circle"></i>
                          <p>Select a server to view ban list</p>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Warning System Tab -->
      <div id="warning-system" class="tab-content">
        <div class="mod-warning-section">
          <!-- Warning System Header -->
          <div class="mod-section-header-wrapper">
            <h2 class="mod-main-title">Warning Management System</h2>
            <p class="mod-main-desc">Issue warnings to users, view warning history, and manage warning policies.</p>
          </div>
          
          <div class="mod-warning-container">
            <!-- Issue Warning Form -->
            <div class="mod-warn-user">
              <div class="mod-section-header">
                <div class="mod-section-icon warning-icon">
                  <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h3>Issue Warning</h3>
                <div class="mod-premium-badge">
                  <span>ULTRA</span>
                </div>
              </div>
              <div class="mod-section-content">
                <p class="mod-desc">Issue a warning to a user in the selected server. Warnings will be tracked and can be used for automated moderation.</p>
                <form id="warnUserForm" action="/admin3d/warnings/add" method="POST">
                  <input type="hidden" id="warnServerId" name="serverId">
                  
                  <div class="admin3d-form-group">
                    <label class="admin3d-form-label" for="warnUserId">User ID or @mention</label>
                    <input class="admin3d-form-input" type="text" id="warnUserId" name="userId" placeholder="Enter user ID or @mention" required>
                  </div>
                  
                  <div class="admin3d-form-group">
                    <label class="admin3d-form-label" for="warnReason">Warning Reason</label>
                    <textarea class="admin3d-form-textarea" id="warnReason" name="reason" placeholder="Explain the reason for this warning..." required rows="3"></textarea>
                  </div>
                  
                  <div class="admin3d-form-options">
                    <div class="admin3d-form-check">
                      <input type="checkbox" id="notifyUser" name="notifyUser" checked>
                      <label for="notifyUser">Notify user via DM</label>
                    </div>
                  </div>
                  
                  <div class="admin3d-form-actions">
                    <button type="submit" class="admin3d-btn admin3d-btn-warning">
                      <i class="fas fa-exclamation-triangle"></i>
                      <span>Issue Warning</span>
                    </button>
                  </div>
                </form>
              </div>
            </div>
            
            <!-- Warning List -->
            <div class="mod-current-warnings">
              <div class="mod-section-header">
                <div class="mod-section-icon list-icon">
                  <i class="fas fa-list"></i>
                </div>
                <h3>Warning History</h3>
                <div id="refreshWarnings" class="mod-refresh-btn" title="Refresh warnings list">
                  <i class="fas fa-sync-alt"></i>
                </div>
              </div>
              <div class="mod-section-content">
                <div class="admin3d-search-filters">
                  <div class="admin3d-search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" id="warningSearchInput" placeholder="Search warnings...">
                  </div>
                </div>
                
                <div class="admin3d-table-wrapper">
                  <table class="admin3d-table">
                    <thead>
                      <tr>
                        <th>User</th>
                        <th>Reason</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody id="warningListBody">
                      <tr class="empty-state">
                        <td colspan="5">
                          <div class="empty-state-message">
                            <i class="fas fa-info-circle"></i>
                            <p>Please select a server to view warnings</p>
                          </div>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Warning Statistics and Management -->
          <div class="mod-warning-stats-container">
            <div class="mod-warning-stats">
              <div class="mod-section-header">
                <div class="mod-section-icon warning-stats-icon">
                  <i class="fas fa-chart-bar"></i>
                </div>
                <h3>Warning Statistics</h3>
              </div>
              <div class="mod-section-content">
                <div class="warning-stats-grid">
                  <div class="warning-stat-item">
                    <div class="warning-stat-value" id="totalServerWarnings">-</div>
                    <div class="warning-stat-label">Total Warnings</div>
                  </div>
                  <div class="warning-stat-item">
                    <div class="warning-stat-value" id="activeWarnings">-</div>
                    <div class="warning-stat-label">Active Warnings</div>
                  </div>
                  <div class="warning-stat-item">
                    <div class="warning-stat-value" id="warnedUsers">-</div>
                    <div class="warning-stat-label">Warned Users</div>
                  </div>
                  <div class="warning-stat-item">
                    <div class="warning-stat-value" id="avgWarningsPerUser">-</div>
                    <div class="warning-stat-label">Avg. Per User</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- User Warning Details Modal (will be shown when clicking on a user) -->
          <div id="userWarningModal" class="mod-modal">
            <div class="mod-modal-content">
              <div class="mod-modal-header">
                <h3>User Warning Details</h3>
                <span class="mod-modal-close">&times;</span>
              </div>
              <div class="mod-modal-body">
                <div class="user-warning-profile">
                  <div class="user-warning-avatar">
                    <img src="https://cdn.discordapp.com/embed/avatars/0.png" alt="User Avatar" id="warningUserAvatar">
                  </div>
                  <div class="user-warning-info">
                    <h4 id="warningUserName">Username</h4>
                    <div id="warningUserId">User ID</div>
                    <div class="user-warning-count">
                      <span id="userWarningCount">0</span> warnings
                    </div>
                  </div>
                </div>
                
                <div class="user-warning-list" id="userWarningList">
                  <!-- Warning items will be inserted here by JavaScript -->
                </div>
                
                <div class="user-warning-actions">
                  <button class="mod-btn warning-clear-btn" id="clearUserWarnings">
                    <i class="fas fa-trash-alt"></i> Clear All Warnings
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Auto-Moderation Tab -->
      <div id="auto-moderation" class="tab-content">
        <div class="mod-automod-section">
          <!-- Auto-Moderation Header -->
          <div class="mod-section-header-wrapper">
            <h2 class="mod-main-title">Auto-Moderation System</h2>
            <p class="mod-main-desc">Configure automatic moderation rules for your Discord server. Set up content filtering, spam protection, and automated actions.</p>
          </div>
          
          <div class="mod-automod-container">
            <!-- Auto-Mod Settings -->
            <div class="mod-automod-settings">
              <div class="mod-section-header">
                <div class="mod-section-icon shield-icon">
                  <i class="fas fa-shield-alt"></i>
                </div>
                <h3>Auto-Mod Configuration</h3>
                <div class="mod-premium-badge">
                  <span>ULTRA</span>
                </div>
              </div>
              <div class="mod-section-content">
                <form id="automod-settings-form" action="/admin3d/moderation/automod-settings" method="POST">
                  <input type="hidden" name="serverId" id="automod-server-selector">
                  
                  <div class="automod-setting-group">
                    <h4>General Settings</h4>
                    <div class="form-check automod-toggle">
                      <input type="checkbox" id="enableAutomod" name="enableAutomod" class="toggle-input">
                      <label for="enableAutomod" class="toggle-label">
                        <span class="toggle-switch"></span>
                        <span class="toggle-text">Enable Auto-Moderation</span>
                      </label>
                    </div>
                    
                    <div class="form-check automod-toggle">
                      <input type="checkbox" id="logActions" name="logActions" class="toggle-input">
                      <label for="logActions" class="toggle-label">
                        <span class="toggle-switch"></span>
                        <span class="toggle-text">Log All Auto-Mod Actions</span>
                      </label>
                    </div>
                    
                    <div class="admin3d-form-group">
                      <label class="admin3d-form-label" for="logChannel">Log Channel</label>
                      <select class="admin3d-form-select" id="logChannel" name="logChannel">
                        <option value="">Select a channel</option>
                        <!-- Channels will be populated by JavaScript -->
                      </select>
                    </div>
                  </div>
                  
                  <div class="automod-setting-group">
                    <h4>Content Filtering</h4>
                    <div class="form-check automod-toggle">
                      <input type="checkbox" id="filterProfanity" name="filterProfanity" class="toggle-input">
                      <label for="filterProfanity" class="toggle-label">
                        <span class="toggle-switch"></span>
                        <span class="toggle-text">Filter Profanity</span>
                      </label>
                    </div>
                    
                    <div class="form-check automod-toggle">
                      <input type="checkbox" id="filterLinks" name="filterLinks" class="toggle-input">
                      <label for="filterLinks" class="toggle-label">
                        <span class="toggle-switch"></span>
                        <span class="toggle-text">Filter Links</span>
                      </label>
                    </div>
                    
                    <div class="form-check automod-toggle">
                      <input type="checkbox" id="filterInvites" name="filterInvites" class="toggle-input">
                      <label for="filterInvites" class="toggle-label">
                        <span class="toggle-switch"></span>
                        <span class="toggle-text">Filter Discord Invites</span>
                      </label>
                    </div>
                    
                    <div class="form-check automod-toggle">
                      <input type="checkbox" id="filterMassMentions" name="filterMassMentions" class="toggle-input">
                      <label for="filterMassMentions" class="toggle-label">
                        <span class="toggle-switch"></span>
                        <span class="toggle-text">Filter Mass Mentions</span>
                      </label>
                    </div>
                    
                    <div class="admin3d-form-group">
                      <label class="admin3d-form-label" for="mentionThreshold">Mention Threshold</label>
                      <input class="admin3d-form-input" type="number" id="mentionThreshold" name="mentionThreshold" min="3" max="20" value="5">
                      <div class="admin3d-form-hint">Number of mentions that triggers moderation</div>
                    </div>
                  </div>
                  
                  <div class="automod-setting-group">
                    <h4>Spam Protection</h4>
                    <div class="form-check automod-toggle">
                      <input type="checkbox" id="antiSpam" name="antiSpam" class="toggle-input">
                      <label for="antiSpam" class="toggle-label">
                        <span class="toggle-switch"></span>
                        <span class="toggle-text">Enable Anti-Spam</span>
                      </label>
                    </div>
                    
                    <div class="admin3d-form-group">
                      <label class="admin3d-form-label" for="spamThreshold">Message Threshold</label>
                      <input class="admin3d-form-input" type="number" id="spamThreshold" name="spamThreshold" min="3" max="15" value="5">
                      <div class="admin3d-form-hint">Number of messages in time window</div>
                    </div>
                    
                    <div class="admin3d-form-group">
                      <label class="admin3d-form-label" for="spamTimeWindow">Time Window (seconds)</label>
                      <input class="admin3d-form-input" type="number" id="spamTimeWindow" name="spamTimeWindow" min="3" max="30" value="5">
                      <div class="admin3d-form-hint">Time window for spam detection</div>
                    </div>
                    
                    <div class="form-check automod-toggle">
                      <input type="checkbox" id="antiCaps" name="antiCaps" class="toggle-input">
                      <label for="antiCaps" class="toggle-label">
                        <span class="toggle-switch"></span>
                        <span class="toggle-text">Filter Excessive Caps</span>
                      </label>
                    </div>
                    
                    <div class="admin3d-form-group">
                      <label class="admin3d-form-label" for="capsThreshold">Caps Threshold (%)</label>
                      <input class="admin3d-form-input" type="number" id="capsThreshold" name="capsThreshold" min="50" max="100" value="70">
                      <div class="admin3d-form-hint">Percentage of caps that triggers moderation</div>
                    </div>
                  </div>
                  
                  <div class="automod-setting-group">
                    <h4>Automated Actions</h4>
                    <div class="admin3d-form-group">
                      <label class="admin3d-form-label" for="defaultAction">Default Action</label>
                      <select class="admin3d-form-select" id="defaultAction" name="defaultAction">
                        <option value="delete">Delete Message</option>
                        <option value="warn">Warn User</option>
                        <option value="mute">Timeout User</option>
                        <option value="kick">Kick User</option>
                        <option value="ban">Ban User</option>
                      </select>
                    </div>
                    
                    <div class="admin3d-form-group">
                      <label class="admin3d-form-label" for="muteTime">Default Timeout Duration</label>
                      <div class="admin3d-duration-inputs">
