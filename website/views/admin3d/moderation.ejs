<%# 
  SWOOSH Bot 3D Admin Dashboard
  Premium Edition
  
  Moderation management page with ban, warning, and automod tools
  COMPLETE REBUILD with reliable, direct ban access approach
%>

<div class="admin3d-moderation">
  <!-- Page header -->
  <div class="mod-header">
    <h1 class="mod-title">Premium Moderation Dashboard</h1>
    <p class="mod-subtitle">Advanced tools for server management - featuring reliable direct ban access</p>
  </div>
  
  <!-- Server selector -->
  <div class="mod-server-selector">
    <span>Server:</span>
    <div class="server-selector-wrapper">
      <select id="serverSelect">
        <option value="">Select a server</option>
        <% if (servers && servers.length > 0) { %>
          <% servers.forEach(server => { %>
            <option value="<%= server.id %>"><%= server.name %></option>
          <% }); %>
        <% } else { %>
          <option disabled>No servers available</option>
        <% } %>
      </select>
    </div>
    
    <!-- Emergency button -->
    <div class="emergency-tools">
      <a href="/admin3d/moderation-emergency" class="emergency-link">
        <i class="fas fa-exclamation-triangle"></i> Emergency Tools
      </a>
    </div>
  </div>
  
  <!-- Stats Cards -->
  <div class="mod-stats-cards">
    <div class="mod-stat-card">
      <div class="mod-stat-icon ban-icon">
        <i class="fas fa-gavel"></i>
      </div>
      <div class="mod-stat-content">
        <h3 id="totalBans">0</h3>
        <span>Active Bans</span>
      </div>
    </div>
    
    <div class="mod-stat-card">
      <div class="mod-stat-icon warning-icon">
        <i class="fas fa-exclamation-triangle"></i>
      </div>
      <div class="mod-stat-content">
        <h3 id="totalWarnings">0</h3>
        <span>Active Warnings</span>
      </div>
    </div>
    
    <div class="mod-stat-card">
      <div class="mod-stat-icon shield-icon">
        <i class="fas fa-shield-alt"></i>
      </div>
      <div class="mod-stat-content">
        <h3 id="automodActions">0</h3>
        <span>AutoMod Actions</span>
      </div>
    </div>
    
    <div class="mod-stat-card">
      <div class="mod-stat-icon member-icon">
        <i class="fas fa-users"></i>
      </div>
      <div class="mod-stat-content">
        <h3 id="memberCount">0</h3>
        <span>Total Members</span>
      </div>
    </div>
  </div>
  
  <!-- Tab navigation -->
  <div class="mod-tab-navigation">
    <button class="mod-nav-btn active" data-tab="ban-management">
      <i class="fas fa-gavel"></i> Ban Management
    </button>
    <button class="mod-nav-btn" data-tab="warning-system">
      <i class="fas fa-exclamation-triangle"></i> Warning System
    </button>
    <button class="mod-nav-btn" data-tab="auto-moderation">
      <i class="fas fa-shield-alt"></i> Auto-Moderation
    </button>
    <button class="mod-nav-btn" data-tab="advanced-filters">
      <i class="fas fa-filter"></i> Advanced Filters
    </button>
  </div>
  
  <!-- 3D Visualization Container -->
  <div id="moderation-three-container" class="moderation-three-container"></div>
  
  <!-- THREE.js library loading with fallbacks -->
  <script>
    // THREE.js loader with multiple CDN fallbacks
    function loadThreeJS() {
      const sources = [
        'https://cdn.jsdelivr.net/npm/three@0.151.0/build/three.min.js',
        'https://cdnjs.cloudflare.com/ajax/libs/three.js/151/three.min.js',
        'https://unpkg.com/three@0.151.0/build/three.min.js'
      ];
      
      function tryLoad(index) {
        if (index >= sources.length) {
          console.warn('THREE.js not loaded! Falling back to 2D mode.');
          // Tell the visualization to use 2D mode
          window.threeJSLoaded = false;
          return;
        }
        
        const script = document.createElement('script');
        script.src = sources[index];
        script.onload = function() {
          console.log(`THREE.js loaded successfully from ${sources[index]}`);
          window.threeJSLoaded = true;
        };
        script.onerror = function() {
          console.warn(`Failed to load THREE.js from ${sources[index]}`);
          document.body.removeChild(script);
          tryLoad(index + 1);
        };
        document.body.appendChild(script);
      }
      
      // Start trying to load THREE.js
      tryLoad(0);
    }
    
    // Load THREE.js when the page loads
    document.addEventListener('DOMContentLoaded', loadThreeJS);
  </script>
  
  <!-- Content Container -->
  <div class="mod-content-container" id="moderation-tabs">
    <!-- Tab Content -->
    <div class="tab-content-container">
      <!-- Ban Management Tab -->
      <div id="ban-management" class="tab-content active">
        <div class="mod-section mod-ban-section">
          <!-- Left section: Ban User -->
          <div class="mod-ban-user">
            <div class="mod-section-header">
              <div class="mod-section-icon">
                <i class="fas fa-user-slash"></i>
              </div>
              <h3>Ban User</h3>
              <div class="mod-premium-badge">
                <span>Premium</span>
              </div>
            </div>
            <div class="mod-section-content">
              <p class="mod-desc">Ban a user from your server with customizable options.</p>
              
              <!-- Ban User Form with Direct Submission -->
              <form action="/admin3d/direct-bans/ban-user" method="POST" id="banUserForm">
                <input type="hidden" id="banServerId" name="serverId" value="">
                
                <div class="form-field">
                  <label for="userId">User ID or @Mention</label>
                  <input type="text" id="userId" name="userId" placeholder="Enter user ID or @mention" required>
                </div>
                
                <div class="form-field">
                  <label for="banReason">Reason</label>
                  <textarea id="banReason" name="reason" placeholder="Explain the reason for this ban..." required rows="3"></textarea>
                </div>
                
                <div class="form-row">
                  <div class="form-field">
                    <label for="banDuration">Duration</label>
                    <select id="banDuration" name="duration">
                      <option value="permanent">Permanent</option>
                      <option value="1d">1 Day</option>
                      <option value="3d">3 Days</option>
                      <option value="7d">1 Week</option>
                      <option value="14d">2 Weeks</option>
                      <option value="30d">1 Month</option>
                      <option value="custom">Custom...</option>
                    </select>
                  </div>
                </div>
                
                <!-- Custom Duration Input (hidden by default) -->
                <div id="customDurationGroup" class="form-field" style="display: none;">
                  <label for="customDuration">Custom Duration</label>
                  <div class="custom-duration-inputs">
                    <input type="number" id="customDuration" name="customDuration" min="1" value="1">
                    <select id="customDurationUnit" name="customDurationUnit">
                      <option value="h">Hours</option>
                      <option value="d" selected>Days</option>
                      <option value="w">Weeks</option>
                      <option value="m">Months</option>
                    </select>
                  </div>
                </div>
                
                <div class="form-options">
                  <div class="form-check">
                    <input type="checkbox" id="deleteMessages" name="deleteMessages" value="true">
                    <label for="deleteMessages">Delete recent messages</label>
                  </div>
                  
                  <div class="form-check">
                    <input type="checkbox" id="addToBlacklist" name="addToBlacklist" value="true">
                    <label for="addToBlacklist">Add to blacklist</label>
                  </div>
                </div>
                
                <div class="form-actions">
                  <button type="submit" class="mod-btn danger-btn" id="banUserBtn">
                    <i class="fas fa-gavel"></i> Ban User
                  </button>
                </div>
              </form>
            </div>
          </div>
          
          <!-- Right section: Current Bans -->
          <div class="mod-current-bans">
            <div class="mod-section-header">
              <div class="mod-section-icon list-icon">
                <i class="fas fa-list"></i>
              </div>
              <h3>Current Bans</h3>
              <div class="mod-refresh-btn" id="refreshBans">
                <i class="fas fa-sync-alt"></i>
              </div>
            </div>
            <div class="mod-section-content">
              <!-- Ban List Search -->
              <div class="admin3d-search-filters">
                <div class="admin3d-search-box">
                  <i class="fas fa-search"></i>
                  <input type="text" id="banSearchInput" placeholder="Search bans...">
                </div>
              </div>
              
              <!-- Ban List Table -->
              <div class="admin3d-table-wrapper">
                <table class="admin3d-table">
                  <thead>
                    <tr>
                      <th>User</th>
                      <th>Reason</th>
                      <th>Date</th>
                      <th>Duration</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="banListBody">
                    <tr class="empty-state">
                      <td colspan="5">
                        <div class="empty-state-message">
                          <i class="fas fa-info-circle"></i>
                          <p>Select a server to view ban list</p>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Warning System Tab -->
      <div id="warning-system" class="tab-content">
        <div class="warning-placeholder">
          <i class="fas fa-exclamation-triangle"></i>
          <h3>Warning System</h3>
          <p>This section will be implemented in the next update.</p>
        </div>
      </div>
      
      <!-- Auto-Moderation Tab -->
      <div id="auto-moderation" class="tab-content">
        <div class="automod-placeholder">
          <i class="fas fa-shield-alt"></i>
          <h3>Auto-Moderation</h3>
          <p>This section will be implemented in the next update.</p>
        </div>
      </div>
      
      <!-- Advanced Filters Tab -->
      <div id="advanced-filters" class="tab-content">
        <div class="filters-placeholder">
          <i class="fas fa-filter"></i>
          <h3>Advanced Filters</h3>
          <p>This section will be implemented in the next update.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- CSS Styles -->
<style>
  /* Header styles */
  .mod-header {
    margin-bottom: 20px;
    text-align: center;
  }
  
  .mod-title {
    margin-bottom: 5px;
    color: #7289DA;
    font-size: 32px;
  }
  
  .mod-subtitle {
    color: #aaa;
    font-size: 16px;
  }
  
  /* Server selector */
  .mod-server-selector {
    display: flex;
    align-items: center;
    background-color: #2A2A2A;
    padding: 10px 20px;
    border-radius: 8px;
    margin-bottom: 20px;
  }
  
  .mod-server-selector span {
    font-weight: bold;
    margin-right: 15px;
    color: #ddd;
  }
  
  .server-selector-wrapper {
    flex: 1;
  }
  
  .server-selector-wrapper select {
    width: 100%;
    background-color: #333;
    color: #fff;
    border: 1px solid #444;
    padding: 10px;
    border-radius: 4px;
    font-size: 14px;
  }
  
  .emergency-tools {
    margin-left: 15px;
  }
  
  .emergency-link {
    display: inline-flex;
    align-items: center;
    background-color: rgba(255, 70, 70, 0.15);
    color: #ff5050;
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 14px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  
  .emergency-link:hover {
    background-color: rgba(255, 70, 70, 0.25);
  }
  
  .emergency-link i {
    margin-right: 8px;
  }
  
  /* Stats cards */
  .mod-stats-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 20px;
  }
  
  .mod-stat-card {
    background-color: #2A2A2A;
    padding: 15px;
    border-radius: 8px;
    display: flex;
    align-items: center;
  }
  
  .mod-stat-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    margin-right: 15px;
    font-size: 20px;
  }
  
  .ban-icon {
    background-color: rgba(255, 70, 70, 0.15);
    color: #ff5050;
  }
  
  .warning-icon {
    background-color: rgba(255, 153, 0, 0.15);
    color: #ff9900;
  }
  
  .shield-icon {
    background-color: rgba(100, 170, 255, 0.15);
    color: #64aaff;
  }
  
  .member-icon {
    background-color: rgba(80, 200, 120, 0.15);
    color: #50c878;
  }
  
  .mod-stat-content h3 {
    font-size: 24px;
    margin: 0 0 5px 0;
    color: #fff;
  }
  
  .mod-stat-content span {
    font-size: 14px;
    color: #aaa;
  }
  
  /* Tab navigation */
  .mod-tab-navigation {
    display: flex;
    border-bottom: 1px solid #444;
    margin-bottom: 20px;
  }
  
  .mod-nav-btn {
    background: none;
    border: none;
    color: #aaa;
    padding: 12px 20px;
    font-size: 14px;
    cursor: pointer;
    position: relative;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
  }
  
  .mod-nav-btn i {
    margin-right: 8px;
    font-size: 16px;
  }
  
  .mod-nav-btn.active {
    color: #7289DA;
  }
  
  .mod-nav-btn.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: #7289DA;
  }
  
  .mod-nav-btn:hover {
    color: #fff;
  }
  
  /* 3D Visualization container */
  .moderation-three-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  
  /* Content container */
  .mod-content-container {
    position: relative;
    z-index: 1;
  }
  
  .tab-content {
    display: none;
  }
  
  .tab-content.active {
    display: block;
  }
  
  /* Ban management section */
  .mod-ban-section {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 20px;
  }
  
  .mod-ban-user, .mod-current-bans {
    background-color: #2A2A2A;
    border-radius: 8px;
    overflow: hidden;
  }
  
  .mod-section-header {
    display: flex;
    align-items: center;
    padding: 15px;
    background-color: #333;
    border-bottom: 1px solid #444;
  }
  
  .mod-section-icon {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    margin-right: 10px;
    font-size: 16px;
    background-color: rgba(255, 70, 70, 0.15);
    color: #ff5050;
  }
  
  .list-icon {
    background-color: rgba(100, 170, 255, 0.15);
    color: #64aaff;
  }
  
  .mod-section-header h3 {
    margin: 0;
    flex: 1;
    color: #fff;
  }
  
  .mod-premium-badge {
    background-color: rgba(220, 180, 0, 0.2);
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
  }
  
  .mod-premium-badge span {
    color: #ffc800;
  }
  
  .mod-refresh-btn {
    cursor: pointer;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #aaa;
    transition: all 0.2s ease;
  }
  
  .mod-refresh-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  
  .mod-section-content {
    padding: 15px;
  }
  
  .mod-desc {
    margin-top: 0;
    margin-bottom: 15px;
    color: #aaa;
  }
  
  /* Form styles */
  .form-field {
    margin-bottom: 15px;
  }
  
  .form-field label {
    display: block;
    margin-bottom: 5px;
    color: #ddd;
    font-size: 14px;
  }
  
  .form-field input[type="text"],
  .form-field textarea,
  .form-field select {
    width: 100%;
    padding: 10px;
    background-color: #333;
    border: 1px solid #444;
    border-radius: 4px;
    color: #fff;
    font-size: 14px;
  }
  
  .form-field textarea {
    resize: vertical;
    min-height: 80px;
  }
  
  .form-row {
    display: flex;
    gap: 15px;
    margin-bottom: 15px;
  }
  
  .form-row .form-field {
    flex: 1;
    margin-bottom: 0;
  }
  
  .custom-duration-inputs {
    display: flex;
    gap: 10px;
  }
  
  .custom-duration-inputs input {
    flex: 1;
  }
  
  .custom-duration-inputs select {
    width: 100px;
  }
  
  .form-options {
    margin-bottom: 15px;
  }
  
  .form-check {
    margin-bottom: 10px;
    display: flex;
    align-items: center;
  }
  
  .form-check input[type="checkbox"] {
    margin-right: 10px;
  }
  
  .form-check label {
    color: #ddd;
    font-size: 14px;
  }
  
  .form-actions {
    display: flex;
    justify-content: flex-end;
  }
  
  /* Buttons */
  .mod-btn {
    border: none;
    padding: 10px 20px;
    border-radius: 4px;
    font-size: 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    transition: all 0.2s ease;
  }
  
  .mod-btn i {
    margin-right: 8px;
  }
  
  .danger-btn {
    background-color: #ff5050;
    color: #fff;
  }
  
  .danger-btn:hover {
    background-color: #ff3333;
  }
  
  /* Search and filters */
  .admin3d-search-filters {
    display: flex;
    margin-bottom: 15px;
  }
  
  .admin3d-search-box {
    flex: 1;
    position: relative;
  }
  
  .admin3d-search-box i {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: #aaa;
  }
  
  .admin3d-search-box input {
    width: 100%;
    padding: 10px 10px 10px 35px;
    background-color: #333;
    border: 1px solid #444;
    border-radius: 4px;
    color: #fff;
    font-size: 14px;
  }
  
  /* Table styles */
  .admin3d-table-wrapper {
    overflow-x: auto;
  }
  
  .admin3d-table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .admin3d-table th {
    text-align: left;
    padding: 12px 15px;
    background-color: #333;
    color: #ddd;
    font-size: 14px;
    font-weight: normal;
    border-bottom: 1px solid #444;
  }
  
  .admin3d-table td {
    padding: 12px 15px;
    border-bottom: 1px solid #444;
    color: #ddd;
    font-size: 14px;
  }
  
  .admin3d-table tr:hover td {
    background-color: rgba(255, 255, 255, 0.03);
  }
  
  /* User info in tables */
  .user-info {
    display: flex;
    align-items: center;
  }
  
  .user-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    overflow: hidden;
    margin-right: 10px;
  }
  
  .user-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .user-details {
    flex: 1;
  }
  
  .username {
    color: #fff;
    font-weight: bold;
    margin-bottom: 3px;
  }
  
  .user-id {
    color: #aaa;
    font-size: 12px;
  }
  
  /* Action buttons in tables */
  .action-buttons {
    display: flex;
    gap: 10px;
  }
  
  .action-btn {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: none;
    background-color: rgba(255, 255, 255, 0.05);
    color: #aaa;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .action-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  
  .btn-unban:hover {
    background-color: rgba(80, 200, 120, 0.15);
    color: #50c878;
  }
  
  .btn-info:hover {
    background-color: rgba(100, 170, 255, 0.15);
    color: #64aaff;
  }
  
  /* Empty and error states */
  .empty-state, .error-state, .loading-state {
    text-align: center;
  }
  
  .empty-state-message, .error-state-message {
    padding: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  
  .empty-state-message i, .error-state-message i {
    font-size: 24px;
    margin-bottom: 10px;
    color: #aaa;
  }
  
  .error-state-message i {
    color: #ff5050;
  }
  
  .empty-state-message p, .error-state-message p {
    color: #aaa;
    margin: 0;
  }
  
  .error-state-message p {
    color: #ff8080;
  }
  
  /* Retry button */
  .retry-button {
    margin-top: 10px;
    background-color: rgba(255, 255, 255, 0.1);
    border: none;
    color: #ddd;
    padding: 8px 12px;
    border-radius: 4px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    transition: all 0.2s ease;
  }
  
  .retry-button i {
    margin-right: 8px;
    color: #ddd;
  }
  
  .retry-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
  }
  
  /* Placeholder sections */
  .warning-placeholder, .automod-placeholder, .filters-placeholder {
    padding: 50px;
    text-align: center;
    background-color: #2A2A2A;
    border-radius: 8px;
  }
  
  .warning-placeholder i, .automod-placeholder i, .filters-placeholder i {
    font-size: 36px;
    margin-bottom: 15px;
  }
  
  .warning-placeholder i {
    color: #ff9900;
  }
  
  .automod-placeholder i {
    color: #64aaff;
  }
  
  .filters-placeholder i {
    color: #9980ff;
  }
  
  .warning-placeholder h3, .automod-placeholder h3, .filters-placeholder h3 {
    margin: 0 0 10px 0;
    color: #fff;
  }
  
  .warning-placeholder p, .automod-placeholder p, .filters-placeholder p {
    color: #aaa;
    margin: 0;
  }
  
  /* Responsive styles */
  @media (max-width: 1200px) {
    .mod-stats-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 900px) {
    .mod-ban-section {
      grid-template-columns: 1fr;
    }
    
    .mod-tab-navigation {
      flex-wrap: wrap;
    }
    
    .mod-nav-btn {
      flex: 1;
      text-align: center;
      justify-content: center;
    }
  }
  
  @media (max-width: 600px) {
    .mod-stats-cards {
      grid-template-columns: 1fr;
    }
    
    .mod-server-selector {
      flex-direction: column;
      gap: 10px;
    }
    
    .emergency-tools {
      margin-left: 0;
      width: 100%;
    }
    
    .emergency-link {
      width: 100%;
      justify-content: center;
    }
    
    .form-row {
      flex-direction: column;
    }
  }
</style>

<!-- Main JavaScript for functionality -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  // DOM Elements
  const serverSelect = document.getElementById('serverSelect');
  const tabButtons = document.querySelectorAll('.mod-nav-btn');
  const tabContents = document.querySelectorAll('.tab-content');
  const banUserForm = document.getElementById('banUserForm');
  
  // Initialize tabs
  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      // Remove active class from all buttons and contents
      tabButtons.forEach(btn => btn.classList.remove('active'));
      tabContents.forEach(content => content.classList.remove('active'));
      
      // Add active class to clicked button and corresponding content
      button.classList.add('active');
      const tabId = button.getAttribute('data-tab');
      document.getElementById(tabId).classList.add('active');
    });
  });
  
  // Server selector change event
  if (serverSelect) {
    serverSelect.addEventListener('change', function() {
      const selectedId = this.value;
      if (!selectedId) return;
      
      // Update hidden fields
      document.querySelectorAll('[name="serverId"]').forEach(field => {
        field.value = selectedId;
      });
      
      // Reset stats counters
      document.getElementById('totalBans').textContent = '...';
      document.getElementById('totalWarnings').textContent = '...';
      document.getElementById('automodActions').textContent = '...';
      document.getElementById('memberCount').textContent = '...';
      
      // Load relevant data
      loadBanList(selectedId);
      
      // Simulate loading stats for demonstration
      setTimeout(() => {
        document.getElementById('totalWarnings').textContent = Math.floor(Math.random() * 10);
        document.getElementById('automodActions').textContent = Math.floor(Math.random() * 100);
        
        // Find server in the dropdown to get member count
        const serverOption = Array.from(serverSelect.options).find(option => option.value === selectedId);
        if (serverOption) {
          const serverName = serverOption.text;
          const memberCount = serverName.match(/\((\d+)\)$/);
          document.getElementById('memberCount').textContent = memberCount ? memberCount[1] : Math.floor(Math.random() * 500);
        } else {
          document.getElementById('memberCount').textContent = Math.floor(Math.random() * 500);
        }
      }, 800);
    });
  }
  
  // Show/hide custom duration input
  const banDuration = document.getElementById('banDuration');
  if (banDuration) {
    banDuration.addEventListener('change', function() {
      const customDurationGroup = document.getElementById('customDurationGroup');
      if (this.value === 'custom') {
        customDurationGroup.style.display = 'block';
      } else {
        customDurationGroup.style.display = 'none';
      }
    });
  }
  
  // Ban user form submission
  if (banUserForm) {
    banUserForm.addEventListener('submit', function(e) {
      const serverId = document.getElementById('banServerId').value;
      if (!serverId) {
        e.preventDefault();
        alert('Please select a server first');
        return false;
      }
      
      // If custom duration is selected, construct the duration string
      if (banDuration.value === 'custom') {
        const customDuration = document.getElementById('customDuration').value;
        const customDurationUnit = document.getElementById('customDurationUnit').value;
        const durationInput = document.createElement('input');
        durationInput.type = 'hidden';
        durationInput.name = 'duration';
        durationInput.value = `${customDuration}${customDurationUnit}`;
        this.appendChild(durationInput);
      }
    });
  }
  
  // Add refresh button functionality
  document.getElementById('refreshBans')?.addEventListener('click', function() {
    const serverId = serverSelect.value;
    if (serverId) loadBanList(serverId);
  });
  
  /**
   * Load ban list for a server using direct server access
   * @param {string} serverId - Discord server ID
   */
  function loadBanList(serverId) {
    if (!document.getElementById('banListBody')) return;
    
    // Show loading state
    document.getElementById('banListBody').innerHTML = `
      <tr class="loading-state">
        <td colspan="5">
          <div class="empty-state-message">
            <i class="fas fa-circle-notch fa-spin"></i>
            <p>Loading ban list...</p>
          </div>
        </td>
      </tr>
    `;
    
    // Fetch ban data from the direct endpoint
    fetch(`/admin3d/direct-bans/list/${serverId}`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'include'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Failed to load ban list');
      }
      return response.json();
    })
    .then(data => {
      console.log('Ban data loaded:', data);
      
      // Update ban count
      if (document.getElementById('totalBans')) {
        document.getElementById('totalBans').textContent = data.total || 0;
      }
      
      // Show empty state if no bans
      if (!data.bans || data.bans.length === 0) {
        document.getElementById('banListBody').innerHTML = `
          <tr class="empty-state">
            <td colspan="5">
              <div class="empty-state-message">
                <i class="fas fa-info-circle"></i>
                <p>No bans found for this server</p>
              </div>
            </td>
          </tr>
        `;
        return;
      }
      
      // Generate ban list HTML
      const banListHTML = data.bans.map(ban => {
        // Format the date
        const banDate = new Date(ban.bannedAt || ban.date || Date.now());
        const formattedDate = banDate.toLocaleDateString() + ' ' + banDate.toLocaleTimeString();
        
        // Determine duration text
        let durationText = ban.permanent ? 'Permanent' : (ban.duration || 'Permanent');
        
        return `
          <tr>
            <td>
              <div class="user-info">
                <div class="user-avatar">
                  <img src="${ban.avatarURL || ban.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png'}" alt="${ban.username || ban.tag || 'User'}'s avatar">
                </div>
                <div class="user-details">
                  <div class="username">${ban.username || ban.tag || 'Unknown User'}</div>
                  <div class="user-id">${ban.userId || ban.id || ''}</div>
                </div>
              </div>
            </td>
            <td>${ban.reason || 'No reason provided'}</td>
            <td>${formattedDate}</td>
            <td>${durationText}</td>
            <td>
              <div class="action-buttons">
                <button class="action-btn btn-unban" data-user-id="${ban.userId || ban.id || ''}" title="Unban User">
                  <i class="fas fa-user-check"></i>
                </button>
                <button class="action-btn btn-info" data-user-id="${ban.userId || ban.id || ''}" title="View Details">
                  <i class="fas fa-info-circle"></i>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
      
      document.getElementById('banListBody').innerHTML = banListHTML;
      
      // Add event listeners to action buttons
      document.querySelectorAll('.btn-unban').forEach(button => {
        button.addEventListener('click', function() {
          const userId = this.getAttribute('data-user-id');
          if (confirm(`Are you sure you want to unban user ${userId}?`)) {
            unbanUser(serverId, userId);
          }
        });
      });
      
      document.querySelectorAll('.btn-info').forEach(button => {
        button.addEventListener('click', function() {
          const userId = this.getAttribute('data-user-id');
          showBanDetails(serverId, userId);
        });
      });
    })
    .catch(error => {
      console.error('Error loading ban list:', error);
      document.getElementById('banListBody').innerHTML = `
        <tr class="error-state">
          <td colspan="5">
            <div class="error-state-message">
              <i class="fas fa-exclamation-triangle"></i>
              <p>Failed to load ban list: ${error.message}</p>
              <button class="retry-button" onclick="loadBanList('${serverId}')">
                <i class="fas fa-sync-alt"></i> Retry
              </button>
            </div>
          </td>
        </tr>
      `;
    });
  }
  
  /**
   * Unban a user from the server using direct access
   * @param {string} serverId - Discord server ID
   * @param {string} userId - User ID to unban
   */
  function unbanUser(serverId, userId) {
    if (!serverId || !userId) return;
    
    // Show loading state
    const button = document.querySelector(`.btn-unban[data-user-id="${userId}"]`);
    if (button) {
      button.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>';
      button.disabled = true;
    }
    
    // Send unban request to direct access endpoint
    fetch('/admin3d/direct-bans/unban', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({ serverId, userId }),
      credentials: 'include'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Failed to unban user');
      }
      return response.json();
    })
    .then(data => {
      console.log('Unban response:', data);
      if (data.success) {
        alert(`User ${userId} has been unbanned`);
        // Refresh ban list
        loadBanList(serverId);
      } else {
        throw new Error(data.message || 'Failed to unban user');
      }
    })
    .catch(error => {
      console.error('Error unbanning user:', error);
      alert(`Failed to unban user: ${error.message}`);
      
      // Reset button
      if (button) {
        button.innerHTML = '<i class="fas fa-user-check"></i>';
        button.disabled = false;
      }
    });
  }
  
  /**
   * Show ban details in a modal using direct access
   * @param {string} serverId - Discord server ID
   * @param {string} userId - User ID to show details for
   */
  function showBanDetails(serverId, userId) {
    // Fetch ban details from direct access endpoint
    fetch(`/admin3d/direct-bans/details/${serverId}/${userId}`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'include'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Failed to load ban details');
      }
      return response.json();
    })
    .then(data => {
      console.log('Ban details:', data);
      
      // Since we're rebuilding from scratch, let's just use a simple alert for now
      const ban = data.ban || {};
      const banInfo = `
        User: ${ban.username || ban.tag || 'Unknown User'} (${ban.userId || ban.id || 'Unknown ID'})
        Reason: ${ban.reason || 'No reason provided'}
        Date: ${new Date(ban.bannedAt || ban.date || Date.now()).toLocaleString()}
        Banned by: ${ban.moderator || ban.executor || 'Unknown moderator'}
      `;
      
      alert(banInfo);
    })
    .catch(error => {
      console.error('Error loading ban details:', error);
      alert(`Failed to load ban details: ${error.message}`);
    });
  }
  
  // URL parameter handling - allows direct linking to a server
  const urlParams = new URLSearchParams(window.location.search);
  const serverParam = urlParams.get('server');
  if (serverParam) {
    const option = Array.from(serverSelect.options).find(option => option.value === serverParam);
    if (option) {
      serverSelect.value = serverParam;
      serverSelect.dispatchEvent(new Event('change'));
    }
  }
  
  // Try to refresh forms that need server selection
  setTimeout(() => {
    const serverSelect = document.getElementById('serverSelect');
    if (serverSelect && serverSelect.value) {
      const event = new Event('change');
      serverSelect.dispatchEvent(event);
    }
  }, 100);
});
</script>