  /**
   * Load auto-moderation settings for a server
   * @param {string} serverId - Discord server ID
   */
  function loadAutomodSettings(serverId) {
    if (!document.getElementById('enableAutomod')) return;
    
    // Fetch automod settings
    fetch(`/admin3d/moderation/automod-settings/${serverId}`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'include'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Failed to load auto-moderation settings');
      }
      return response.json();
    })
    .then(data => {
      console.log('Automod settings loaded:', data);
      
      if (data.settings) {
        // Update form with loaded settings
        const settings = data.settings;
        document.getElementById('enableAutomod').checked = settings.enabled || false;
        document.getElementById('logActions').checked = settings.logActions || false;
        
        // Populate log channels dropdown
        if (data.channels && data.channels.length > 0) {
          const logChannelSelect = document.getElementById('logChannel');
          logChannelSelect.innerHTML = '<option value="">Select a channel</option>';
          
          data.channels.forEach(channel => {
            const option = document.createElement('option');
            option.value = channel.id;
            option.textContent = '#' + channel.name;
            
            if (settings.logChannel === channel.id) {
              option.selected = true;
            }
            
            logChannelSelect.appendChild(option);
          });
        }
        
        // Content filtering
        document.getElementById('filterProfanity').checked = settings.filters?.profanity || false;
        document.getElementById('filterLinks').checked = settings.filters?.links || false;
        document.getElementById('filterInvites').checked = settings.filters?.invites || false;
        document.getElementById('filterMassMentions').checked = settings.filters?.massMentions || false;
        
        if (settings.mentionThreshold) {
          document.getElementById('mentionThreshold').value = settings.mentionThreshold;
        }
        
        // Spam protection
        document.getElementById('antiSpam').checked = settings.antiSpam?.enabled || false;
        
        if (settings.antiSpam?.messageThreshold) {
          document.getElementById('spamThreshold').value = settings.antiSpam.messageThreshold;
        }
        
        if (settings.antiSpam?.timeWindow) {
          document.getElementById('spamTimeWindow').value = settings.antiSpam.timeWindow;
        }
        
        document.getElementById('antiCaps').checked = settings.filters?.caps || false;
        
        if (settings.capsThreshold) {
          document.getElementById('capsThreshold').value = settings.capsThreshold;
        }
        
        // Actions
        if (settings.defaultAction) {
          document.getElementById('defaultAction').value = settings.defaultAction;
        }
        
        if (settings.muteTime) {
          // Parse mute time format (e.g. "10m", "1h", "1d")
          const match = settings.muteTime.match(/^(\d+)([mhd])$/);
          if (match) {
            document.getElementById('muteTime').value = match[1];
            document.getElementById('muteTimeUnit').value = match[2];
          }
        }
        
        document.getElementById('escalateRepeated').checked = settings.escalateRepeated || false;
        
        if (settings.maxViolations) {
          document.getElementById('maxViolations').value = settings.maxViolations;
        }
        
        // Escalation tiers
        if (settings.tier1Action) {
          document.getElementById('tier1Action').value = settings.tier1Action;
        }
        
        if (settings.tier2Action) {
          document.getElementById('tier2Action').value = settings.tier2Action;
        }
        
        if (settings.tier3Action) {
          document.getElementById('tier3Action').value = settings.tier3Action;
        }
        
        if (settings.tier4Action) {
          document.getElementById('tier4Action').value = settings.tier4Action;
        }
      }
    })
    .catch(error => {
      console.error('Error loading automod settings:', error);
      // No need to show error state, just use defaults
    });
  }
  
  /**
   * Load custom filters for a server
   * @param {string} serverId - Discord server ID
   */
  function loadFiltersList(serverId) {
    if (!document.getElementById('filtersListBody')) return;
    
    // Show loading state
    document.getElementById('filtersListBody').innerHTML = `
      <tr class="loading-state">
        <td colspan="4">
          <div class="empty-state-message">
            <i class="fas fa-circle-notch fa-spin"></i>
            <p>Loading filters...</p>
          </div>
        </td>
      </tr>
    `;
    
    // Fetch filters from the API
    fetch(`/admin3d/moderation/filters/${serverId}`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'include'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Failed to load filters');
      }
      return response.json();
    })
    .then(data => {
      console.log('Filters loaded:', data);
      
      // Show empty state if no filters
      if (!data.filters || data.filters.length === 0) {
        document.getElementById('filtersListBody').innerHTML = `
          <tr class="empty-state">
            <td colspan="4">
              <div class="empty-state-message">
                <i class="fas fa-info-circle"></i>
                <p>No custom filters found for this server</p>
              </div>
            </td>
          </tr>
        `;
        return;
      }
      
      // Generate filters list HTML
      const filtersListHTML = data.filters.map(filter => {
        // Format the filter type for display
        const filterType = {
          'word': 'Word/Phrase',
          'regex': 'Regex Pattern',
          'domain': 'Domain'
        }[filter.type] || filter.type;
        
        // Format the action for display
        const actionText = {
          'delete': 'Delete Message',
          'warn': 'Warn User',
          'mute': 'Timeout User',
          'kick': 'Kick User',
          'ban': 'Ban User'
        }[filter.action] || filter.action;
        
        return `
          <tr>
            <td>${filterType}</td>
            <td>${filter.content}</td>
            <td>${actionText}</td>
            <td>
              <div class="action-buttons">
                <button class="action-btn filter-edit-btn" data-filter-id="${filter.id}" title="Edit Filter">
                  <i class="fas fa-edit"></i>
                </button>
                <button class="action-btn filter-remove-btn" data-filter-id="${filter.id}" title="Delete Filter">
                  <i class="fas fa-trash-alt"></i>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
      
      document.getElementById('filtersListBody').innerHTML = filtersListHTML;
      
      // Add event listeners to action buttons
      document.querySelectorAll('.filter-edit-btn').forEach(button => {
        button.addEventListener('click', function() {
          const filterId = this.getAttribute('data-filter-id');
          // For simplicity, we'll just alert for now
          alert('Edit filter functionality will be implemented in the next update.');
        });
      });
      
      document.querySelectorAll('.filter-remove-btn').forEach(button => {
        button.addEventListener('click', function() {
          const filterId = this.getAttribute('data-filter-id');
          if (confirm('Are you sure you want to delete this filter? This action cannot be undone.')) {
            removeFilter(serverId, filterId);
          }
        });
      });
    })
    .catch(error => {
      console.error('Error loading filters:', error);
      document.getElementById('filtersListBody').innerHTML = `
        <tr class="error-state">
          <td colspan="4">
            <div class="error-state-message">
              <i class="fas fa-exclamation-circle"></i>
              <p>Failed to load filters: ${error.message}</p>
              <button class="retry-button" onclick="loadFiltersList('${serverId}')">
                <i class="fas fa-sync-alt"></i> Retry
              </button>
            </div>
          </td>
        </tr>
      `;
    });
  }
  
  /**
   * Remove a custom filter
   * @param {string} serverId - Discord server ID
   * @param {string} filterId - Filter ID
   */
  function removeFilter(serverId, filterId) {
    fetch('/admin3d/moderation/remove-filter', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({
        serverId,
        filterId
      }),
      credentials: 'include'
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Reload filters list to reflect changes
        loadFiltersList(serverId);
      } else {
        alert(`Failed to remove filter: ${data.message}`);
      }
    })
    .catch(error => {
      console.error('Error removing filter:', error);
      alert(`Error removing filter: ${error.message}`);
    });
  }
  
  /**
   * Load auto-moderation logs for a server
   * @param {string} serverId - Discord server ID
   */
  function loadAutomodLogs(serverId) {
    if (!document.getElementById('automodLogsBody')) return;
    
    // Show loading state
    document.getElementById('automodLogsBody').innerHTML = `
      <tr class="loading-state">
        <td colspan="4">
          <div class="empty-state-message">
            <i class="fas fa-circle-notch fa-spin"></i>
            <p>Loading auto-mod logs...</p>
          </div>
        </td>
      </tr>
    `;
    
    // Fetch logs from the API
    fetch(`/admin3d/moderation/automod-logs/${serverId}`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'include'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Failed to load auto-mod logs');
      }
      return response.json();
    })
    .then(data => {
      console.log('Automod logs loaded:', data);
      
      // Show empty state if no logs
      if (!data.logs || data.logs.length === 0) {
        document.getElementById('automodLogsBody').innerHTML = `
          <tr class="empty-state">
            <td colspan="4">
              <div class="empty-state-message">
                <i class="fas fa-info-circle"></i>
                <p>No auto-mod logs found for this server</p>
              </div>
            </td>
          </tr>
        `;
        return;
      }
      
      // Generate logs list HTML
      const logsListHTML = data.logs.map(log => {
        // Format the date
        const logDate = new Date(log.timestamp);
        const formattedDate = logDate.toLocaleDateString() + ' ' + logDate.toLocaleTimeString();
        
        return `
          <tr>
            <td>
              <div class="user-info">
                <div class="user-avatar">
                  <img src="${log.avatarURL || 'https://cdn.discordapp.com/embed/avatars/0.png'}" alt="${log.username}'s avatar">
                </div>
                <div class="user-details">
                  <div class="username">${log.username || 'Unknown User'}</div>
                  <div class="user-id">${log.userId}</div>
                </div>
              </div>
            </td>
            <td>${log.violation}</td>
            <td>${log.action}</td>
            <td>${formattedDate}</td>
          </tr>
        `;
      }).join('');
      
      document.getElementById('automodLogsBody').innerHTML = logsListHTML;
    })
    .catch(error => {
      console.error('Error loading automod logs:', error);
      document.getElementById('automodLogsBody').innerHTML = `
        <tr class="error-state">
          <td colspan="4">
            <div class="error-state-message">
              <i class="fas fa-exclamation-circle"></i>
              <p>Failed to load auto-mod logs: ${error.message}</p>
              <button class="retry-button" onclick="loadAutomodLogs('${serverId}')">
                <i class="fas fa-sync-alt"></i> Retry
              </button>
            </div>
          </td>
        </tr>
      `;
    });
  }

  /**
   * Load ban list for a server using direct server access
   * @param {string} serverId - Discord server ID
   */
  function loadBanList(serverId) {
    if (!document.getElementById('banListBody')) return;
    
    // Show loading state
    document.getElementById('banListBody').innerHTML = `
      <tr class="loading-state">
        <td colspan="5">
          <div class="empty-state-message">
            <i class="fas fa-circle-notch fa-spin"></i>
            <p>Loading ban list...</p>
          </div>
        </td>
      </tr>
    `;
    
    // Fetch ban data from the direct endpoint
    fetch(`/admin3d/direct-bans/list/${serverId}`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'include'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Failed to load ban list');
      }
      return response.json();
    })
    .then(data => {
      console.log('Ban data loaded:', data);
      
      // Update ban count
      if (document.getElementById('totalBans')) {
        document.getElementById('totalBans').textContent = data.total || 0;
      }
      
      // Show empty state if no bans
      if (!data.bans || data.bans.length === 0) {
        document.getElementById('banListBody').innerHTML = `
          <tr class="empty-state">
            <td colspan="5">
              <div class="empty-state-message">
                <i class="fas fa-info-circle"></i>
                <p>No bans found for this server</p>
              </div>
            </td>
          </tr>
        `;
        return;
      }
      
      // Generate ban list HTML
      const banListHTML = data.bans.map(ban => {
        // Format the date
        const banDate = new Date(ban.bannedAt || ban.date || Date.now());
        const formattedDate = banDate.toLocaleDateString() + ' ' + banDate.toLocaleTimeString();
        
        // Determine duration text
        let durationText = ban.permanent ? 'Permanent' : (ban.duration || 'Permanent');
        
        return `
          <tr>
            <td>
              <div class="user-info">
                <div class="user-avatar">
                  <img src="${ban.avatarURL || ban.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png'}" alt="${ban.username || ban.tag || 'User'}'s avatar">
                </div>
                <div class="user-details">
                  <div class="username">${ban.username || ban.tag || 'Unknown User'}</div>
                  <div class="user-id">${ban.userId || ban.id || ''}</div>
                </div>
              </div>
            </td>
            <td>${ban.reason || 'No reason provided'}</td>
            <td>${formattedDate}</td>
            <td>${durationText}</td>
            <td>
              <div class="action-buttons">
                <button class="action-btn btn-unban" data-user-id="${ban.userId || ban.id || ''}" title="Unban User">
                  <i class="fas fa-user-check"></i>
                </button>
                <button class="action-btn btn-info" data-user-id="${ban.userId || ban.id || ''}" title="View Details">
                  <i class="fas fa-info-circle"></i>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
      
      document.getElementById('banListBody').innerHTML = banListHTML;
      
      // Add event listeners to action buttons
      document.querySelectorAll('.btn-unban').forEach(button => {
        button.addEventListener('click', function() {
          const userId = this.getAttribute('data-user-id');
          if (confirm(`Are you sure you want to unban user ${userId}?`)) {
            unbanUser(serverId, userId);
          }
        });
      });
      
      document.querySelectorAll('.btn-info').forEach(button => {
        button.addEventListener('click', function() {
          const userId = this.getAttribute('data-user-id');
          showBanDetails(serverId, userId);
        });
      });
    })
    .catch(error => {
      console.error('Error loading ban list:', error);
      document.getElementById('banListBody').innerHTML = `
        <tr class="error-state">
          <td colspan="5">
            <div class="error-state-message">
              <i class="fas fa-exclamation-triangle"></i>
              <p>Failed to load ban list: ${error.message}</p>
              <button class="retry-button" onclick="loadBanList('${serverId}')">
                <i class="fas fa-sync-alt"></i> Retry
              </button>
            </div>
          </td>
        </tr>
      `;
    });
  }
  
  /**
   * Unban a user from the server using direct access
   * @param {string} serverId - Discord server ID
   * @param {string} userId - User ID to unban
   */
  function unbanUser(serverId, userId) {
    if (!serverId || !userId) return;
    
    // Show loading state
    const button = document.querySelector(`.btn-unban[data-user-id="${userId}"]`);
    if (button) {
      button.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>';
      button.disabled = true;
    }
    
    // Send unban request to direct access endpoint
    fetch('/admin3d/direct-bans/unban', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({ serverId, userId }),
      credentials: 'include'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Failed to unban user');
      }
      return response.json();
    })
    .then(data => {
      console.log('Unban response:', data);
      if (data.success) {
        alert(`User ${userId} has been unbanned`);
        // Refresh ban list
        loadBanList(serverId);
      } else {
        throw new Error(data.message || 'Failed to unban user');
      }
    })
    .catch(error => {
      console.error('Error unbanning user:', error);
      alert(`Failed to unban user: ${error.message}`);
      
      // Reset button
      if (button) {
        button.innerHTML = '<i class="fas fa-user-check"></i>';
        button.disabled = false;
      }
    });
  }
  
  /**
   * Show ban details in a modal using direct access
   * @param {string} serverId - Discord server ID
   * @param {string} userId - User ID to show details for
   */
  function showBanDetails(serverId, userId) {
    // Fetch ban details from direct access endpoint
    fetch(`/admin3d/direct-bans/details/${serverId}/${userId}`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'include'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Failed to load ban details');
      }
      return response.json();
    })
    .then(data => {
      console.log('Ban details:', data);
      
      // Since we're rebuilding from scratch, let's just use a simple alert for now
      const ban = data.ban || {};
      const banInfo = `
        User: ${ban.username || ban.tag || 'Unknown User'} (${ban.userId || ban.id || 'Unknown ID'})
        Reason: ${ban.reason || 'No reason provided'}
        Date: ${new Date(ban.bannedAt || ban.date || Date.now()).toLocaleString()}
        Banned by: ${ban.moderator || ban.executor || 'Unknown moderator'}
      `;
      
      alert(banInfo);
    })
    .catch(error => {
      console.error('Error loading ban details:', error);
      alert(`Failed to load ban details: ${error.message}`);
    });
  }
  
  // URL parameter handling - allows direct linking to a server
  const urlParams = new URLSearchParams(window.location.search);
  const serverParam = urlParams.get('server');
  if (serverParam) {
    const option = Array.from(serverSelect.options).find(option => option.value === serverParam);
    if (option) {
      serverSelect.value = serverParam;
      serverSelect.dispatchEvent(new Event('change'));
    }
  }
  
  // Try to refresh forms that need server selection
  setTimeout(() => {
    const serverSelect = document.getElementById('serverSelect');
    if (serverSelect && serverSelect.value) {
      const event = new Event('change');
      serverSelect.dispatchEvent(event);
    }
  }, 100);
});
</script>

