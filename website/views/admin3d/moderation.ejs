  /**
   * Load warning list for a server
   * @param {string} serverId - Discord server ID
   */
  function loadWarningList(serverId) {
    if (!document.getElementById('warningListBody')) return;
    
    // Update hidden fields for all forms
    if (document.getElementById('warnServerId')) {
      document.getElementById('warnServerId').value = serverId;
    }
    if (document.getElementById('automodServerId')) {
      document.getElementById('automodServerId').value = serverId;
    }
    if (document.getElementById('filterServerId')) {
      document.getElementById('filterServerId').value = serverId;
    }
    
    // Show loading state
    document.getElementById('warningListBody').innerHTML = `
      <tr class="loading-state">
        <td colspan="5">
          <div class="empty-state-message">
            <i class="fas fa-circle-notch fa-spin"></i>
            <p>Loading warnings...</p>
          </div>
        </td>
      </tr>
    `;
    
    // Reset warning stats
    document.getElementById('totalServerWarnings').textContent = '-';
    document.getElementById('activeWarnings').textContent = '-';
    document.getElementById('warnedUsers').textContent = '-';
    document.getElementById('avgWarningsPerUser').textContent = '-';
    
    // Fetch warning data from the API
    fetch(`/admin3d/warnings/list/${serverId}`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      credentials: 'include'
    })
    .then(response => {
      if (!response.ok) {
        throw new Error('Failed to load warnings');
      }
      return response.json();
    })
    .then(data => {
      console.log('Warning data loaded:', data);
      
      // Update warning count in stats section
      const totalWarnings = data.warnings?.length || 0;
      document.getElementById('totalServerWarnings').textContent = totalWarnings;
      
      // Calculate active warnings
      const activeWarnings = data.warnings?.filter(w => w.active).length || 0;
      document.getElementById('activeWarnings').textContent = activeWarnings;
      
      // Calculate warned users (unique)
      const uniqueUsers = new Set();
      data.warnings?.forEach(w => uniqueUsers.add(w.userId));
      const warnedUsers = uniqueUsers.size;
      document.getElementById('warnedUsers').textContent = warnedUsers;
      
      // Calculate average warnings per user
      const avgWarnings = warnedUsers > 0 ? (totalWarnings / warnedUsers).toFixed(1) : '0';
      document.getElementById('avgWarningsPerUser').textContent = avgWarnings;
      
      // Show empty state if no warnings
      if (!data.warnings || data.warnings.length === 0) {
        document.getElementById('warningListBody').innerHTML = `
          <tr class="empty-state">
            <td colspan="5">
              <div class="empty-state-message">
                <i class="fas fa-info-circle"></i>
                <p>No warnings found for this server</p>
              </div>
            </td>
          </tr>
        `;
        return;
      }
      
      // Generate warnings list HTML
      const warningsListHTML = data.warnings.map(warning => {
        // Format the date
        const warningDate = new Date(warning.timestamp);
        const formattedDate = warningDate.toLocaleDateString() + ' ' + warningDate.toLocaleTimeString();
        
        // Determine status text and class
        const statusClass = warning.active ? 'warning-active' : 'warning-inactive';
        const statusText = warning.active ? 'Active' : 'Inactive';
        
        return `
          <tr>
            <td>
              <div class="user-info">
                <div class="user-avatar">
                  <img src="${warning.avatarURL || 'https://cdn.discordapp.com/embed/avatars/0.png'}" alt="${warning.username}'s avatar">
                </div>
                <div class="user-details">
                  <div class="username">${warning.username || 'Unknown User'}</div>
                  <div class="user-id">${warning.userId}</div>
                </div>
              </div>
            </td>
            <td>${warning.reason || 'No reason provided'}</td>
            <td>${formattedDate}</td>
            <td><span class="warning-item-status ${statusClass}">${statusText}</span></td>
            <td>
              <div class="action-buttons">
                <button class="action-btn warning-toggle-btn" data-warning-id="${warning.id}" data-active="${warning.active}" title="${warning.active ? 'Deactivate' : 'Activate'} Warning">
                  <i class="fas ${warning.active ? 'fa-toggle-on' : 'fa-toggle-off'}"></i>
                </button>
                <button class="action-btn warning-user-btn" data-user-id="${warning.userId}" title="View User Warnings">
                  <i class="fas fa-user"></i>
                </button>
                <button class="action-btn warning-remove-btn" data-warning-id="${warning.id}" title="Delete Warning">
                  <i class="fas fa-trash-alt"></i>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
      
      document.getElementById('warningListBody').innerHTML = warningsListHTML;
      
      // Add event listeners to action buttons
      document.querySelectorAll('.warning-toggle-btn').forEach(button => {
        button.addEventListener('click', function() {
          const warningId = this.getAttribute('data-warning-id');
          const isActive = this.getAttribute('data-active') === 'true';
          toggleWarningStatus(serverId, warningId, !isActive);
        });
      });
      
      document.querySelectorAll('.warning-user-btn').forEach(button => {
        button.addEventListener('click', function() {
          const userId = this.getAttribute('data-user-id');
          showUserWarningDetails(serverId, userId);
        });
      });
      
      document.querySelectorAll('.warning-remove-btn').forEach(button => {
        button.addEventListener('click', function() {
          const warningId = this.getAttribute('data-warning-id');
          if (confirm('Are you sure you want to delete this warning? This action cannot be undone.')) {
            removeWarning(serverId, warningId);
          }
        });
      });
    })
    .catch(error => {
      console.error('Error loading warnings:', error);
      document.getElementById('warningListBody').innerHTML = `
        <tr class="error-state">
          <td colspan="5">
            <div class="error-state-message">
              <i class="fas fa-exclamation-circle"></i>
              <p>Failed to load warnings: ${error.message}</p>
              <button class="retry-button" onclick="loadWarningList('${serverId}')">
                <i class="fas fa-sync-alt"></i> Retry
              </button>
            </div>
          </td>
        </tr>
      `;
    });
  }
  
  /**
   * Toggle warning status (active/inactive)
   * @param {string} serverId - Discord server ID
   * @param {string} warningId - Warning ID
   * @param {boolean} active - New active status
   */
  function toggleWarningStatus(serverId, warningId, active) {
    fetch('/admin3d/warnings/update-status', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({
        serverId,
        warningId,
        active
      }),
      credentials: 'include'
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Reload warnings list to reflect changes
        loadWarningList(serverId);
      } else {
        alert(`Failed to update warning status: ${data.message}`);
      }
    })
    .catch(error => {
      console.error('Error updating warning status:', error);
      alert(`Error updating warning status: ${error.message}`);
    });
  }
  
