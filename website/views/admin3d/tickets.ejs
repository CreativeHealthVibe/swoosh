<div class="tickets-container dark-theme admin3d-tickets-premium">
  <div class="tickets-header">
    <h1>Ticket Management</h1>
    <p>Manage support tickets across your Discord servers</p>
  </div>

  <% if (!ticketManagerAvailable) { %>
    <div class="alert alert-warning">
      <i class="fas fa-exclamation-triangle"></i>
      <span>Ticket manager is not available. Please make sure the ticket system is properly set up in your Discord bot.</span>
    </div>
  <% } %>

  <div class="server-selector premium-server-selector">
    <div class="server-select-wrapper">
      <label for="server-select">Select a Server:</label>
      <div class="select-container">
        <select id="server-select" class="form-control premium-select">
          <option value="" selected disabled>- Select a server</option>
          <% if (guilds && guilds.length > 0) { %>
            <% guilds.forEach(guild => { %>
              <option value="<%= guild.id %>"><%= guild.name %> (<%= guild.memberCount || 'N/A' %> members)</option>
            <% }); %>
          <% } %>
        </select>
        <div class="select-arrow">
          <i class="fas fa-chevron-down"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="tabs">
    <ul class="nav nav-tabs">
      <li class="nav-item">
        <a class="nav-link active" id="tickets-tab" data-toggle="tab" href="#tickets-content">Tickets</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" id="settings-tab" data-toggle="tab" href="#settings-content">Settings</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" id="panels-tab" data-toggle="tab" href="#panels-content">Ticket Panels</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" id="quick-setup-tab" data-toggle="tab" href="#quick-setup-content">Quick Setup</a>
      </li>
    </ul>
  </div>

  <div class="tab-content">
    <!-- Tickets Tab -->
    <div class="tab-pane fade show active" id="tickets-content">
      <div class="row stats-row premium-glow-container">
        <div class="col-md-3">
          <div class="stat-card ticket-stat-card premium-card">
            <div class="stat-icon">
              <i class="fas fa-ticket-alt"></i>
            </div>
            <div class="stat-content">
              <h3 id="total-tickets" class="stat-value">0</h3>
              <p class="stat-title">Total Tickets</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card ticket-stat-card premium-card">
            <div class="stat-icon">
              <i class="fas fa-door-open"></i>
            </div>
            <div class="stat-content">
              <h3 id="open-tickets" class="stat-value">0</h3>
              <p class="stat-title">Open Tickets</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card ticket-stat-card premium-card">
            <div class="stat-icon">
              <i class="fas fa-door-closed"></i>
            </div>
            <div class="stat-content">
              <h3 id="closed-tickets" class="stat-value">0</h3>
              <p class="stat-title">Closed Tickets</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card ticket-stat-card premium-card">
            <div class="stat-icon">
              <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
              <h3 id="avg-response-time" class="stat-value">-</h3>
              <p class="stat-title">Avg. Response Time</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Premium 3D visualization container -->
      <div class="tickets-3d-container">
        <div id="three-container"></div>
        <div class="ticket3d-loading">
          <div class="spinner"></div>
          <p>Loading premium 3D visualization...</p>
        </div>
      </div>

      <div class="ticket-list-container">
        <div class="ticket-list-header">
          <h3>Ticket List</h3>
          <div class="ticket-filters">
            <select id="status-filter" class="form-control">
              <option value="all">All Status</option>
              <option value="open">Open</option>
              <option value="closed">Closed</option>
            </select>
            <select id="type-filter" class="form-control">
              <option value="all">All Types</option>
              <!-- Will be populated via JavaScript -->
            </select>
            <input type="text" id="search-tickets" class="form-control" placeholder="Search tickets...">
          </div>
        </div>
        
        <div class="ticket-list">
          <table class="table table-dark premium-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>User</th>
                <th>Type</th>
                <th>Created</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="ticket-list-body">
              <!-- Will be populated via JavaScript -->
              <tr class="no-tickets-row">
                <td colspan="6" class="text-center">No tickets found or no server selected.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Settings Tab -->
    <div class="tab-pane fade" id="settings-content">
      <div class="ticket-config-container premium-3d-hover fluid-animation">
        <div class="premium-config-badge">PREMIUM</div>
        <div class="ticket-config-title">
          <div class="ticket-config-title-icon float-animation">
            <i class="fas fa-cog"></i>
          </div>
          <div class="ticket-config-title-text">
            <h3>Ticket System Configuration</h3>
            <p>Configure how tickets work in your server</p>
          </div>
        </div>

        <form id="ticket-settings-form" class="ticket-config-form">
          <div class="form-group form-group-premium">
            <label><i class="fas fa-folder"></i> Ticket Category</label>
            <div class="enhanced-select-container">
              <select id="category-id" name="categoryId" class="form-control">
                <option value="">- Select Category -</option>
                <!-- Will be populated via JavaScript -->
              </select>
            </div>
            <small class="form-text">The category where ticket channels will be created</small>
          </div>

          <div class="form-group form-group-premium">
            <label><i class="fas fa-user-shield"></i> Support Role</label>
            <div class="enhanced-select-container">
              <select id="support-role-id" name="supportRoleId" class="form-control">
                <option value="">- Select Role -</option>
                <!-- Will be populated via JavaScript -->
              </select>
            </div>
            <small class="form-text">Role that will automatically have access to all tickets</small>
          </div>

          <div class="form-group form-group-premium">
            <label><i class="fas fa-history"></i> Log Channel</label>
            <div class="enhanced-select-container">
              <select id="log-channel-id" name="logChannelId" class="form-control">
                <option value="">- Select Channel -</option>
                <!-- Will be populated via JavaScript -->
              </select>
            </div>
            <small class="form-text">Channel where ticket activity will be logged</small>
          </div>

          <div class="form-row">
            <div class="col-md-6">
              <div class="form-group form-group-premium">
                <label><i class="fas fa-ticket-alt"></i> Maximum Tickets Per User</label>
                <div class="number-input-container">
                  <input type="number" id="max-tickets" name="maxTickets" class="form-control" value="1" min="1" max="5">
                </div>
                <small class="form-text">Maximum number of open tickets a user can have</small>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group form-group-premium">
                <label><i class="fas fa-clock"></i> Ticket Cooldown (seconds)</label>
                <div class="number-input-container">
                  <input type="number" id="cooldown" name="cooldown" class="form-control" value="60" min="0">
                </div>
                <small class="form-text">Time users must wait between creating tickets</small>
              </div>
            </div>
          </div>

          <div class="form-group form-group-premium">
            <label><i class="fas fa-sliders-h"></i> Options</label>
            <div class="premium-options-container">
              <div class="form-check premium-check">
                <input class="form-check-input" type="checkbox" id="auto-transcript" name="autoTranscript" value="true">
                <label class="form-check-label" for="auto-transcript">
                  <span class="checkbox-custom"></span>
                  <span class="checkbox-label">Automatically save transcript when closing tickets</span>
                </label>
              </div>
              
              <div class="form-check premium-check">
                <input class="form-check-input" type="checkbox" id="auto-close" name="autoClose" value="true">
                <label class="form-check-label" for="auto-close">
                  <span class="checkbox-custom"></span>
                  <span class="checkbox-label">Automatically close inactive tickets</span>
                </label>
              </div>
              
              <div class="form-check premium-check">
                <input class="form-check-input" type="checkbox" id="require-topic" name="requireTopic" value="true">
                <label class="form-check-label" for="require-topic">
                  <span class="checkbox-custom"></span>
                  <span class="checkbox-label">Require users to specify a topic</span>
                </label>
              </div>
              
              <div class="form-check premium-check">
                <input class="form-check-input" type="checkbox" id="use-threads" name="useThreads" value="true">
                <label class="form-check-label" for="use-threads">
                  <span class="checkbox-custom"></span>
                  <span class="checkbox-label">Use threads instead of channels for tickets</span>
                </label>
              </div>
            </div>
          </div>

          <div class="form-group form-group-premium auto-close-settings" style="display:none;">
            <label><i class="fas fa-hourglass-half"></i> Inactive Hours</label>
            <div class="number-input-container">
              <input type="number" id="inactive-hours" name="inactiveHours" class="form-control" value="24" min="1">
            </div>
            <small class="form-text">Hours of inactivity before auto-closing a ticket</small>
          </div>

          <div class="form-group form-group-premium auto-close-settings" style="display:none;">
            <label><i class="fas fa-comment-slash"></i> Auto-Close Message</label>
            <textarea id="auto-close-message" name="autoCloseMessage" class="form-control" rows="2">This ticket has been automatically closed due to inactivity.</textarea>
            <small class="form-text">Message sent when auto-closing a ticket</small>
          </div>

          <div class="form-group form-group-premium">
            <label><i class="fas fa-comment-dots"></i> Welcome Message</label>
            <textarea id="welcome-message" name="welcomeMessage" class="form-control" rows="3">Thanks for creating a ticket! The support team will assist you shortly. Please describe your issue in detail.</textarea>
            <small class="form-text">Message sent when a new ticket is created</small>
          </div>

          <div class="form-group form-group-premium">
            <label><i class="fas fa-door-closed"></i> Close Message</label>
            <textarea id="close-message" name="closeMessage" class="form-control" rows="3">This ticket is now closed. If you need further assistance, please open a new ticket.</textarea>
            <small class="form-text">Message sent when a ticket is closed</small>
          </div>

          <div class="ticket-config-save">
            <button type="submit" class="premium-btn premium-primary premium-lg premium-glow">
              <i class="fas fa-save"></i> Save Configuration
            </button>
            <button type="button" id="reset-settings" class="premium-btn premium-secondary premium-lg premium-glow" style="margin-left: 15px;">
              <i class="fas fa-undo"></i> Reset to Defaults
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Panels Tab -->
    <div class="tab-pane fade" id="panels-content">
      <div class="panels-container fluid-animation" style="background: linear-gradient(135deg, rgba(12,12,12,0.9) 0%, rgba(0,0,0,0.95) 100%);">
        <div class="premium-header premium-glow">
          <div class="premium-header-icon floating-animation">
            <i class="fas fa-layer-group"></i>
          </div>
          <div class="premium-header-text">
            <h3>Ticket Panels</h3>
            <p>Create and manage premium support ticket panels</p>
          </div>
        </div>
        
        <div class="premium-panels-preview">
          <div class="preview-container reflection-effect premium-3d-hover">
            <div class="preview-header">
              <i class="fas fa-eye"></i> Live Preview
            </div>
            <div class="preview-content">
              <div class="preview-embed" id="panel-preview">
                <div class="preview-embed-title" id="preview-title">Support Tickets</div>
                <div class="preview-embed-description" id="preview-description">Select an option below to create a support ticket. Our team will assist you as soon as possible.</div>
                <div class="preview-embed-image" id="preview-image" style="display:none;"></div>
                <div class="preview-embed-buttons">
                  <button class="preview-button" disabled>
                    <span class="preview-emoji">🔧</span> General Support
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <form id="panel-form">
          <div class="form-row">
            <div class="col-md-6">
              <div class="form-group form-group-premium">
                <label>
                  <i class="fas fa-hashtag"></i> Channel
                </label>
                <select id="panel-channel-id" name="channelId" class="form-control" required>
                  <option value="">- Select Channel -</option>
                  <!-- Will be populated via JavaScript -->
                </select>
                <small class="form-text">Channel where the ticket panel will be sent</small>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group form-group-premium">
                <label>
                  <i class="fas fa-palette"></i> Panel Color
                </label>
                <div class="color-picker-container">
                  <input type="color" id="panel-color" name="panelColor" class="form-control color-input" value="#000000">
                  <div class="color-presets">
                    <span class="color-preset" style="background-color: #5865F2;" data-color="#5865F2"></span>
                    <span class="color-preset" style="background-color: #57F287;" data-color="#57F287"></span>
                    <span class="color-preset" style="background-color: #EB459E;" data-color="#EB459E"></span>
                    <span class="color-preset" style="background-color: #ED4245;" data-color="#ED4245"></span>
                    <span class="color-preset" style="background-color: #000000;" data-color="#000000"></span>
                  </div>
                </div>
                <small class="form-text">Color for the ticket panel embed</small>
              </div>
            </div>
          </div>

          <div class="form-group form-group-premium">
            <label>
              <i class="fas fa-heading"></i> Panel Title
            </label>
            <input type="text" id="panel-title" name="panelTitle" class="form-control" value="Support Tickets" required>
            <small class="form-text">Title of the ticket panel embed</small>
          </div>

          <div class="form-group form-group-premium">
            <label>
              <i class="fas fa-align-left"></i> Panel Description
            </label>
            <textarea id="panel-description" name="panelDescription" class="form-control" rows="3" required>Select an option below to create a support ticket. Our team will assist you as soon as possible.</textarea>
            <small class="form-text">Description text for the ticket panel</small>
          </div>

          <div class="form-group form-group-premium">
            <label>
              <i class="fas fa-image"></i> Panel Image <span class="optional-tag">Optional</span>
            </label>
            <div class="input-group">
              <div class="input-group-prepend">
                <span class="input-group-text"><i class="fas fa-link"></i></span>
              </div>
              <input type="url" id="panel-image" name="panelImage" class="form-control" placeholder="https://example.com/image.png">
              <div class="input-group-append">
                <button class="btn btn-outline-secondary" type="button" id="test-image-btn">Test</button>
              </div>
            </div>
            <small class="form-text">Image URL to display in the panel (recommended: 800×200px)</small>
          </div>

          <div class="form-group form-group-premium">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <label class="mb-0">
                <i class="fas fa-ticket-alt"></i> Ticket Types
              </label>
              <button type="button" id="add-ticket-type" class="premium-btn premium-secondary premium-sm premium-glow">
                <i class="fas fa-plus"></i> Add Ticket Type
              </button>
            </div>
            
            <div id="ticket-types-container" class="ticket-types-premium">
              <!-- First ticket type (default) -->
              <div class="ticket-type-row" data-index="0">
                <div class="ticket-type-card premium-3d-hover reflection-effect">
                  <div class="ticket-type-header">
                    <div class="type-emoji-display floating-animation">🔧</div>
                    <div class="ticket-type-actions">
                      <button type="button" class="premium-btn premium-danger premium-sm remove-ticket-type">
                        <i class="fas fa-times"></i>
                      </button>
                    </div>
                  </div>
                  <div class="ticket-type-body">
                    <div class="form-group">
                      <label>Label</label>
                      <input type="text" class="form-control type-label" 
                             name="ticketTypes[0][label]" placeholder="Label" value="General Support" required>
                    </div>
                    <div class="form-group">
                      <label>Emoji</label>
                      <input type="text" class="form-control type-emoji" 
                             name="ticketTypes[0][emoji]" placeholder="Emoji" value="🔧" required>
                    </div>
                    <div class="form-group">
                      <label>Description</label>
                      <input type="text" class="form-control type-description" 
                             name="ticketTypes[0][description]" placeholder="Description" value="General questions and support">
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="form-buttons text-center">
            <button type="submit" class="premium-btn premium-primary premium-lg premium-glow">
              <i class="fas fa-broadcast-tower"></i> Deploy Panel
            </button>
          </div>
        </form>
      </div>
      
      <div class="existing-panels-container">
        <h3 class="premium-header-text"><i class="fas fa-list"></i> Your Existing Panels</h3>
        <div class="existing-panels-list premium-glow" id="existing-panels">
          <div class="panel-empty-state reflection-effect">
            <i class="fas fa-info-circle floating-animation"></i>
            <p>No panels have been created yet for this server</p>
          </div>
          <!-- Will be populated via JavaScript -->
        </div>
      </div>
    </div>

    <!-- Quick Setup Tab (similar to .setup-tickets command) -->
    <div class="tab-pane fade" id="quick-setup-content">
      <div class="quick-setup-container premium-3d-hover fluid-animation">
        <div class="premium-config-badge">PREMIUM</div>
        <div class="ticket-config-title">
          <div class="ticket-config-title-icon float-animation">
            <i class="fas fa-coins"></i>
          </div>
          <div class="ticket-config-title-text">
            <h3>Bounty System Setup</h3>
            <p>Quickly set up bounty ticket panels in your Discord server</p>
          </div>
        </div>

        <div class="quick-setup-info premium-glow-container">
          <div class="quick-setup-info-icon">
            <i class="fas fa-info-circle"></i>
          </div>
          <div class="quick-setup-info-text">
            <p>This feature sets up a ticket panel focused on the bounty system in your Discord server, similar to using the <code>.setup-tickets</code> command.</p>
            <p>The bot will create a panel with options for claiming and setting bounties, XP claims, and general support tickets.</p>
            <p>Users can select "Claim Bounty" to submit evidence, "Set Bounty" to create new bounties, and "Claim XP" for XP-related inquiries.</p>
          </div>
        </div>

        <form id="quick-setup-form" class="ticket-config-form">
          <div class="form-group form-group-premium">
            <label><i class="fas fa-server"></i> Select Server</label>
            <div class="enhanced-select-container">
              <select id="setup-server-select" name="serverId" class="form-control" required>
                <option value="">- Select Server -</option>
                <!-- Will be populated via JavaScript from the same list as the main selector -->
              </select>
            </div>
            <small class="form-text">The Discord server where you want to set up tickets</small>
          </div>

          <div class="form-group form-group-premium">
            <label><i class="fas fa-hashtag"></i> Target Channel</label>
            <div class="enhanced-select-container">
              <select id="setup-channel-id" name="channelId" class="form-control" required>
                <option value="">- Select Channel -</option>
                <!-- Will be populated via JavaScript -->
              </select>
            </div>
            <small class="form-text">The text channel where the ticket panel will be sent</small>
          </div>

          <div class="form-group form-group-premium">
            <label><i class="fas fa-palette"></i> Panel Color</label>
            <div class="color-picker-container">
              <input type="color" id="setup-panel-color" name="panelColor" class="form-control color-input" value="#000000">
              <div class="color-presets">
                <span class="color-preset" style="background-color: #5865F2;" data-color="#5865F2"></span>
                <span class="color-preset" style="background-color: #57F287;" data-color="#57F287"></span>
                <span class="color-preset" style="background-color: #EB459E;" data-color="#EB459E"></span>
                <span class="color-preset" style="background-color: #ED4245;" data-color="#ED4245"></span>
                <span class="color-preset" style="background-color: #000000;" data-color="#000000"></span>
              </div>
            </div>
            <small class="form-text">Color for the ticket panel embed</small>
          </div>

          <div class="form-row">
            <div class="col-md-6">
              <div class="form-group form-group-premium">
                <label><i class="fas fa-heading"></i> Panel Title</label>
                <input type="text" id="setup-panel-title" name="panelTitle" class="form-control" value="🎫 SWOOSH Support Tickets" required>
                <small class="form-text">Title of the ticket panel embed</small>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group form-group-premium">
                <label><i class="fas fa-folder"></i> Ticket Category (Optional)</label>
                <div class="enhanced-select-container">
                  <select id="setup-category-id" name="categoryId" class="form-control">
                    <option value="">- Auto Create -</option>
                    <!-- Will be populated via JavaScript -->
                  </select>
                </div>
                <small class="form-text">Optional category for ticket channels (will create if missing)</small>
              </div>
            </div>
          </div>

          <div class="form-group form-group-premium">
            <label><i class="fas fa-align-left"></i> Panel Description</label>
            <textarea id="setup-panel-description" name="panelDescription" class="form-control" rows="3" required>Select an option below to interact with the bounty system. Claim bounties by submitting evidence, set new bounties, or request support.</textarea>
            <small class="form-text">Description text for the ticket panel</small>
          </div>
          
          <div class="form-group form-group-premium">
            <label><i class="fas fa-list-ul"></i> Ticket Types</label>
            <div class="bounty-ticket-types">
              <div class="ticket-type-item">
                <div class="type-checkbox">
                  <input type="checkbox" id="claim-bounty-type" name="ticketTypes[]" value="claim_bounty" checked disabled>
                  <label for="claim-bounty-type">
                    <span class="checkbox-custom"></span>
                  </label>
                </div>
                <div class="type-content">
                  <div class="type-header">
                    <span class="type-emoji">💰</span>
                    <span class="type-name">Claim Bounty</span>
                  </div>
                  <div class="type-description">
                    Submit evidence to claim a bounty
                  </div>
                </div>
              </div>
              
              <div class="ticket-type-item">
                <div class="type-checkbox">
                  <input type="checkbox" id="set-bounty-type" name="ticketTypes[]" value="set_bounty" checked disabled>
                  <label for="set-bounty-type">
                    <span class="checkbox-custom"></span>
                  </label>
                </div>
                <div class="type-content">
                  <div class="type-header">
                    <span class="type-emoji">🎯</span>
                    <span class="type-name">Set Bounty</span>
                  </div>
                  <div class="type-description">
                    Set a new bounty on a player
                  </div>
                </div>
              </div>
              
              <div class="ticket-type-item">
                <div class="type-checkbox">
                  <input type="checkbox" id="claim-xp-type" name="ticketTypes[]" value="claim_xp_role" checked disabled>
                  <label for="claim-xp-type">
                    <span class="checkbox-custom"></span>
                  </label>
                </div>
                <div class="type-content">
                  <div class="type-header">
                    <span class="type-emoji">⭐</span>
