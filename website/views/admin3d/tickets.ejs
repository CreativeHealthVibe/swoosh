<!-- Ticket Management Scripts -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize Ticket Management Page
  initTicketsPage();
  
  // Tab Navigation
  const tabButtons = document.querySelectorAll('.tab-button');
  const tabPanes = document.querySelectorAll('.tab-pane');
  
  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      // Remove active class from all buttons and panes
      tabButtons.forEach(btn => btn.classList.remove('active'));
      tabPanes.forEach(pane => pane.classList.remove('active'));
      
      // Add active class to clicked button and corresponding pane
      button.classList.add('active');
      const tabId = button.getAttribute('data-tab');
      document.getElementById(tabId).classList.add('active');
    });
  });
  
  // Add Ticket Type Button
  const addTicketTypeButton = document.getElementById('add-ticket-type');
  if (addTicketTypeButton) {
    addTicketTypeButton.addEventListener('click', addTicketType);
  }
  
  // Initialize Remove Ticket Type buttons
  initRemoveTicketTypeButtons();
  
  // Initialize Tab Navigation
  const tabs = document.querySelectorAll('.tab-button');
  const tabContent = document.querySelectorAll('.tab-pane');
  
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;
      
      // Remove active class from all tabs and content
      tabs.forEach(t => t.classList.remove('active'));
      tabContent.forEach(c => c.classList.remove('active'));
      
      // Add active class to current tab and content
      tab.classList.add('active');
      document.getElementById(target).classList.add('active');
    });
  });
});

/**
 * Add a new ticket type to the form
 */
function addTicketType() {
  const container = document.querySelector('.ticket-types-container');
  const index = container.children.length;
  
  const ticketTypeItem = document.createElement('div');
  ticketTypeItem.className = 'ticket-type-item';
  ticketTypeItem.dataset.index = index;
  
  ticketTypeItem.innerHTML = `
    <div class="admin3d-form-row">
      <div class="admin3d-form-group">
        <label>Label:</label>
        <input type="text" class="admin3d-form-input ticket-type-label" placeholder="General Support">
      </div>
      <div class="admin3d-form-group">
        <label>Value/ID:</label>
        <input type="text" class="admin3d-form-input ticket-type-value" placeholder="general">
      </div>
      <div class="admin3d-form-group">
        <label>Emoji (optional):</label>
        <input type="text" class="admin3d-form-input ticket-type-emoji" placeholder="🔧">
      </div>
      <div class="admin3d-form-group form-actions">
        <button type="button" class="admin3d-btn admin3d-btn-sm admin3d-btn-danger remove-ticket-type">
          <i class="fas fa-trash"></i>
        </button>
      </div>
    </div>
  `;
  
  container.appendChild(ticketTypeItem);
  
  // Add event listener to new remove button
  const removeButton = ticketTypeItem.querySelector('.remove-ticket-type');
  removeButton.addEventListener('click', function() {
    container.removeChild(ticketTypeItem);
    updateTicketTypesJson();
  });
  
  // Update ticket types JSON
  updateTicketTypesJson();
}

/**
 * Initialize remove ticket type buttons
 */
function initRemoveTicketTypeButtons() {
  document.querySelectorAll('.remove-ticket-type').forEach(button => {
    button.addEventListener('click', function() {
      const ticketTypeItem = this.closest('.ticket-type-item');
      ticketTypeItem.parentNode.removeChild(ticketTypeItem);
      updateTicketTypesJson();
    });
  });
}

/**
 * Update the hidden JSON field with ticket types data
 */
function updateTicketTypesJson() {
  const ticketTypes = [];
  document.querySelectorAll('.ticket-type-item').forEach((item, index) => {
    const label = item.querySelector('.ticket-type-label').value;
    const value = item.querySelector('.ticket-type-value').value;
    const emoji = item.querySelector('.ticket-type-emoji').value;
    
    if (label && value) {
      ticketTypes.push({
        label,
        value,
        emoji: emoji || null
      });
    }
  });
  
  document.getElementById('ticket-types-json').value = JSON.stringify(ticketTypes);
}

/**
 * Open ticket info modal
 * @param {string} ticketId - ID of the ticket to show
 */
function openTicketInfoModal(ticketId) {
  // Set ticket ID
  const modal = document.getElementById('ticket-info-modal');
  modal.setAttribute('data-ticket-id', ticketId);
  
  // Show loading state
  document.getElementById('ticket-info-id').textContent = `Ticket #${ticketId}`;
  document.getElementById('ticket-user-name').textContent = 'Loading...';
  document.getElementById('ticket-user-id').textContent = '';
  document.getElementById('ticket-info-status').textContent = 'Loading...';
  document.getElementById('ticket-info-created').textContent = 'Loading...';
  document.getElementById('ticket-info-topic').textContent = 'Loading...';
  document.getElementById('ticket-info-channel').textContent = 'Loading...';
  
  // Show modal
  modal.style.display = 'flex';
  setTimeout(() => {
    modal.style.opacity = '1';
  }, 10);
  
  // Load ticket data
  loadTicketDetails(ticketId);
}

/**
 * Load ticket details for the modal
 * @param {string} ticketId - ID of the ticket to load
 */
async function loadTicketDetails(ticketId) {
  try {
    // Fetch ticket details
    const response = await fetch(`/api/v2/servers/${currentServerId}/tickets/${ticketId}`);
    const data = await response.json();
    
    if (!data.success) {
      throw new Error(data.message || 'Failed to load ticket details');
    }
    
    // Get ticket from response
    const ticket = data.ticket;
    
    // Update modal with ticket details
    document.getElementById('ticket-info-id').textContent = `Ticket #${ticket.id || ticket.number}`;
    
    // Update user info
    if (ticket.user) {
      document.getElementById('ticket-user-name').textContent = ticket.user.username;
      document.getElementById('ticket-user-id').textContent = ticket.user.id;
      
      // Update avatar
      const avatarEl = document.getElementById('ticket-user-avatar');
      if (ticket.user.avatar) {
        avatarEl.innerHTML = `<img src="${ticket.user.avatar}" alt="${escapeHTML(ticket.user.username)}">`;
      } else {
        avatarEl.innerHTML = `<i class="fas fa-user"></i>`;
      }
    } else {
      document.getElementById('ticket-user-name').textContent = 'Unknown User';
      document.getElementById('ticket-user-id').textContent = '';
      document.getElementById('ticket-user-avatar').innerHTML = `<i class="fas fa-user"></i>`;
    }
    
    // Update ticket details
    const statusEl = document.getElementById('ticket-info-status');
    statusEl.textContent = ticket.status;
    statusEl.className = `ticket-status ${ticket.status.toLowerCase()}`;
    
    // Format date
    if (ticket.createdAt) {
      const date = new Date(ticket.createdAt);
      document.getElementById('ticket-info-created').textContent = `${date.toLocaleDateString()} ${date.toLocaleTimeString()}`;
    } else {
      document.getElementById('ticket-info-created').textContent = 'Unknown';
    }
    
    document.getElementById('ticket-info-topic').textContent = ticket.topic || 'No topic';
    document.getElementById('ticket-info-channel').textContent = ticket.channelName || 'Unknown';
    
    // Update messages preview
    const messagesPreview = document.getElementById('ticket-messages-preview');
    messagesPreview.innerHTML = '<div class="ticket-message-loading"><div class="spinner"></div><p>Loading messages...</p></div>';
    
    // Get ticket messages (if available)
    if (ticket.messages && ticket.messages.length > 0) {
      messagesPreview.innerHTML = '';
      
      // Get last 5 messages (or all if less than 5)
      const recentMessages = ticket.messages.slice(-5);
      
      // Add messages to preview
      recentMessages.forEach(message => {
        const messageEl = document.createElement('div');
        messageEl.className = 'ticket-message';
        
        // Format date
        const date = new Date(message.timestamp);
        const timeFormatted = `${date.toLocaleDateString()} ${date.toLocaleTimeString()}`;
        
        // Create avatar element
        const avatar = message.author && message.author.avatar ? 
          `<img src="${message.author.avatar}" alt="${escapeHTML(message.author.username)}">` : 
          `<i class="fas fa-user"></i>`;
        
        messageEl.innerHTML = `
          <div class="ticket-message-avatar">
            ${avatar}
          </div>
          <div class="ticket-message-content">
            <div class="ticket-message-header">
              <div class="ticket-message-name">${escapeHTML(message.author ? message.author.username : 'Unknown User')}</div>
              <div class="ticket-message-time">${timeFormatted}</div>
            </div>
            <div class="ticket-message-text">${escapeHTML(message.content)}</div>
          </div>
        `;
        
        messagesPreview.appendChild(messageEl);
      });
      
      // If no messages, show empty message
      if (recentMessages.length === 0) {
        messagesPreview.innerHTML = '<p class="empty-message">No messages found</p>';
      }
    } else {
      messagesPreview.innerHTML = '<p class="empty-message">No messages found</p>';
    }
    
    // Hide close ticket button if ticket is already closed
    const closeTicketButton = document.querySelector('[data-action="close-ticket"]');
    if (ticket.status.toLowerCase() === 'closed') {
      closeTicketButton.style.display = 'none';
    } else {
      closeTicketButton.style.display = 'inline-block';
    }
  } catch (error) {
    console.error('Error loading ticket details:', error);
    createNotification('error', 'Error', `Failed to load ticket details: ${error.message}`);
    
    // Update modal with error message
    document.getElementById('ticket-info-id').textContent = `Ticket #${ticketId}`;
    document.getElementById('ticket-user-name').textContent = 'Error loading ticket';
    document.getElementById('ticket-user-id').textContent = '';
    document.getElementById('ticket-info-status').textContent = 'Unknown';
    document.getElementById('ticket-info-created').textContent = 'Unknown';
    document.getElementById('ticket-info-topic').textContent = 'Unknown';
    document.getElementById('ticket-info-channel').textContent = 'Unknown';
    
    // Update messages preview
    const messagesPreview = document.getElementById('ticket-messages-preview');
    messagesPreview.innerHTML = `
      <div class="error-message">
        <i class="fas fa-exclamation-triangle"></i>
        <p>Error loading messages: ${error.message}</p>
      </div>
    `;
  }
}

/**
 * Open close ticket modal
 * @param {string} ticketId - ID of the ticket to close
 */
function openCloseTicketModal(ticketId) {
  // Set ticket ID
  const modal = document.getElementById('close-ticket-modal');
  modal.setAttribute('data-ticket-id', ticketId);
  
  // Clear reason input
  document.getElementById('close-reason').value = '';
  
  // Show modal
  modal.style.display = 'flex';
  setTimeout(() => {
    modal.style.opacity = '1';
  }, 10);
}

/**
 * Handle close ticket
 */
async function handleCloseTicket() {
  // Get ticket ID and reason
  const modal = document.getElementById('close-ticket-modal');
  const ticketId = modal.getAttribute('data-ticket-id');
  const reason = document.getElementById('close-reason').value;
  
  if (!ticketId) {
    closeAllModals();
    return;
  }
  
  // Show loading state
  const button = document.querySelector('[data-action="confirm-close"]');
  const originalText = button.innerHTML;
  button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Closing...';
  button.disabled = true;
  
  try {
    // Send request to close ticket
    const response = await fetch(`/api/v2/servers/${currentServerId}/tickets/${ticketId}/close`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ reason })
    });
    
    const data = await response.json();
    
    if (!data.success) {
      throw new Error(data.message || 'Failed to close ticket');
    }
    
    // Show success notification
    createNotification('success', 'Success', 'Ticket closed successfully');
    
    // Close modals
    closeAllModals();
    
    // Reload tickets
    loadTickets();
  } catch (error) {
    console.error('Error closing ticket:', error);
    createNotification('error', 'Error', `Failed to close ticket: ${error.message}`);
    
    // Reset button
    button.innerHTML = originalText;
    button.disabled = false;
  }
}

/**
 * Download transcript for a ticket
 * @param {string} ticketId - ID of the ticket
 */
async function downloadTranscript(ticketId) {
  try {
    // Get transcript from API
    const response = await fetch(`/api/v2/servers/${currentServerId}/tickets/${ticketId}/transcript`);
    const data = await response.json();
    
    if (!data.success) {
      throw new Error(data.message || 'Failed to get transcript');
    }
    
    // If transcript is available
    if (data.transcript && data.transcript.url) {
      // Open transcript in new tab
      window.open(data.transcript.url, '_blank');
    } else {
      throw new Error('Transcript not available');
    }
  } catch (error) {
    console.error('Error getting transcript:', error);
    createNotification('error', 'Error', `Failed to get transcript: ${error.message}`);
  }
}

/**
 * Close all modals
 */
function closeAllModals() {
  const modals = document.querySelectorAll('.admin3d-modal');
  modals.forEach(modal => {
    modal.style.opacity = '0';
    setTimeout(() => {
      modal.style.display = 'none';
    }, 300);
  });
}

/**
 * Populate a channel select dropdown
 * @param {Element} selectElement - The select element to populate
 * @param {Array} channels - Array of channel objects
 */
function populateChannelSelect(selectElement, channels) {
  // Clear existing options
  selectElement.innerHTML = '<option value="" disabled selected>Select channel</option>';
  
  // Add channels grouped by parent
  const channelsByParent = {};
  
  // First, collect channels by parent
  channels.forEach(channel => {
    if (!channelsByParent[channel.parentId]) {
      channelsByParent[channel.parentId] = [];
    }
    channelsByParent[channel.parentId].push(channel);
  });
  
  // Then add them to the select
  Object.keys(channelsByParent).forEach(parentId => {
    // Find parent name
    let parentName = 'No Category';
    if (parentId) {
      const parent = serverCategories.find(c => c.id === parentId);
      if (parent) {
        parentName = parent.name;
      }
    }
    
    // Create optgroup
    const optgroup = document.createElement('optgroup');
    optgroup.label = parentName;
    
    // Add channels
    channelsByParent[parentId].forEach(channel => {
      const option = document.createElement('option');
      option.value = channel.id;
      option.textContent = channel.name;
      optgroup.appendChild(option);
    });
    
    selectElement.appendChild(optgroup);
  });
}

