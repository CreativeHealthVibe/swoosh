<div class="tickets-container dark-theme">
  <div class="tickets-header">
    <h1>Ticket Management</h1>
    <p>Manage support tickets across your Discord servers</p>
  </div>

  <% if (!ticketManagerAvailable) { %>
    <div class="alert alert-warning">
      <i class="fas fa-exclamation-triangle"></i>
      <span>Ticket manager is not available. Please make sure the ticket system is properly set up in your Discord bot.</span>
    </div>
  <% } %>

  <div class="server-selector">
    <label for="server-select">Select a Server:</label>
    <select id="server-select" class="form-control">
      <option value="" selected disabled>- Select a server</option>
      <% if (guilds && guilds.length > 0) { %>
        <% guilds.forEach(guild => { %>
          <option value="<%= guild.id %>"><%= guild.name %> (<%= guild.memberCount || 'N/A' %> members)</option>
        <% }); %>
      <% } %>
    </select>
  </div>

  <div class="tabs">
    <ul class="nav nav-tabs">
      <li class="nav-item">
        <a class="nav-link active" id="tickets-tab" data-toggle="tab" href="#tickets-content">Tickets</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" id="settings-tab" data-toggle="tab" href="#settings-content">Settings</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" id="panels-tab" data-toggle="tab" href="#panels-content">Ticket Panels</a>
      </li>
    </ul>
  </div>

  <div class="tab-content">
    <!-- Tickets Tab -->
    <div class="tab-pane fade show active" id="tickets-content">
      <div class="row stats-row">
        <div class="col-md-3">
          <div class="stat-card" style="--card-index: 0;">
            <div class="stat-icon">
              <i class="fas fa-ticket-alt"></i>
            </div>
            <div class="stat-content">
              <h3 id="total-tickets">0</h3>
              <p>Total Tickets</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card" style="--card-index: 1;">
            <div class="stat-icon">
              <i class="fas fa-door-open"></i>
            </div>
            <div class="stat-content">
              <h3 id="open-tickets">0</h3>
              <p>Open Tickets</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card" style="--card-index: 2;">
            <div class="stat-icon">
              <i class="fas fa-door-closed"></i>
            </div>
            <div class="stat-content">
              <h3 id="closed-tickets">0</h3>
              <p>Closed Tickets</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card" style="--card-index: 3;">
            <div class="stat-icon">
              <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
              <h3 id="avg-response-time">-</h3>
              <p>Avg. Response Time</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Premium 3D visualization container -->
      <div id="three-container">
        <div class="ticket-loading">
          <div class="ticket-loading-ring"></div>
          <p>Loading 3D visualization...</p>
        </div>
        <div class="three-controls">
          <div class="three-control-btn" id="expand-3d" title="Expand View">
            <i class="fas fa-expand"></i>
          </div>
        </div>
      </div>

      <div class="ticket-list-container">
        <div class="ticket-list-header">
          <h3>Ticket List</h3>
          <div class="ticket-filters">
            <select id="status-filter" class="form-control">
              <option value="all">All Status</option>
              <option value="open">Open</option>
              <option value="closed">Closed</option>
            </select>
            <select id="type-filter" class="form-control">
              <option value="all">All Types</option>
              <!-- Will be populated via JavaScript -->
            </select>
            <input type="text" id="search-tickets" class="form-control" placeholder="Search tickets...">
          </div>
        </div>
        
        <div class="ticket-list">
          <table class="table table-dark">
            <thead>
              <tr>
                <th>ID</th>
                <th>User</th>
                <th>Type</th>
                <th>Created</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="ticket-list-body">
              <!-- Will be populated via JavaScript -->
              <tr class="no-tickets-row">
                <td colspan="6" class="text-center">No tickets found or no server selected.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Settings Tab -->
    <div class="tab-pane fade" id="settings-content">
      <div class="settings-container">
        <h3>Ticket System Configuration</h3>
        <p>Configure how tickets work in your server</p>

        <form id="ticket-settings-form">
          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Ticket Category</label>
            <div class="col-sm-9">
              <select id="category-id" name="categoryId" class="form-control">
                <option value="">- Select Category -</option>
                <!-- Will be populated via JavaScript -->
              </select>
              <small class="form-text text-muted">The category where ticket channels will be created</small>
            </div>
          </div>

          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Support Role</label>
            <div class="col-sm-9">
              <select id="support-role-id" name="supportRoleId" class="form-control">
                <option value="">- Select Role -</option>
                <!-- Will be populated via JavaScript -->
              </select>
              <small class="form-text text-muted">Role that will automatically have access to all tickets</small>
            </div>
          </div>

          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Log Channel</label>
            <div class="col-sm-9">
              <select id="log-channel-id" name="logChannelId" class="form-control">
                <option value="">- Select Channel -</option>
                <!-- Will be populated via JavaScript -->
              </select>
              <small class="form-text text-muted">Channel where ticket activity will be logged</small>
            </div>
          </div>

          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Maximum Tickets Per User</label>
            <div class="col-sm-9">
              <input type="number" id="max-tickets" name="maxTickets" class="form-control" value="1" min="1" max="5">
              <small class="form-text text-muted">Maximum number of open tickets a user can have</small>
            </div>
          </div>

          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Ticket Cooldown (seconds)</label>
            <div class="col-sm-9">
              <input type="number" id="cooldown" name="cooldown" class="form-control" value="60" min="0">
              <small class="form-text text-muted">Time users must wait between creating tickets</small>
            </div>
          </div>

          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Options</label>
            <div class="col-sm-9">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="auto-transcript" name="autoTranscript">
                <label class="form-check-label" for="auto-transcript">
                  Automatically save transcript when closing tickets
                </label>
              </div>
              
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="auto-close" name="autoClose">
                <label class="form-check-label" for="auto-close">
                  Automatically close inactive tickets
                </label>
              </div>
              
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="require-topic" name="requireTopic">
                <label class="form-check-label" for="require-topic">
                  Require users to specify a topic
                </label>
              </div>
              
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="use-threads" name="useThreads">
                <label class="form-check-label" for="use-threads">
                  Use threads instead of channels for tickets
                </label>
              </div>
            </div>
          </div>

          <div class="form-group row auto-close-settings" style="display:none;">
            <label class="col-sm-3 col-form-label">Inactive Hours</label>
            <div class="col-sm-9">
              <input type="number" id="inactive-hours" name="inactiveHours" class="form-control" value="24" min="1">
              <small class="form-text text-muted">Hours of inactivity before auto-closing a ticket</small>
            </div>
          </div>

          <div class="form-group row auto-close-settings" style="display:none;">
            <label class="col-sm-3 col-form-label">Auto-Close Message</label>
            <div class="col-sm-9">
              <textarea id="auto-close-message" name="autoCloseMessage" class="form-control" rows="2">This ticket has been automatically closed due to inactivity.</textarea>
              <small class="form-text text-muted">Message sent when auto-closing a ticket</small>
            </div>
          </div>

          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Welcome Message</label>
            <div class="col-sm-9">
              <textarea id="welcome-message" name="welcomeMessage" class="form-control" rows="3">Thanks for creating a ticket! The support team will assist you shortly. Please describe your issue in detail.</textarea>
              <small class="form-text text-muted">Message sent when a new ticket is created</small>
            </div>
          </div>

          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Close Message</label>
            <div class="col-sm-9">
              <textarea id="close-message" name="closeMessage" class="form-control" rows="3">This ticket is now closed. If you need further assistance, please open a new ticket.</textarea>
              <small class="form-text text-muted">Message sent when a ticket is closed</small>
            </div>
          </div>

          <div class="form-buttons">
            <button type="submit" class="btn btn-primary">Save Configuration</button>
            <button type="button" id="reset-settings" class="btn btn-secondary">Reset to Defaults</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Panels Tab -->
    <div class="tab-pane fade" id="panels-content">
      <div class="panels-container">
        <h3>Ticket Panels</h3>
        <p>Create and manage ticket panels in your server</p>

        <form id="panel-form">
          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Channel</label>
            <div class="col-sm-9">
              <select id="panel-channel-id" name="channelId" class="form-control" required>
                <option value="">- Select Channel -</option>
                <!-- Will be populated via JavaScript -->
              </select>
              <small class="form-text text-muted">Channel where the ticket panel will be sent</small>
            </div>
          </div>

          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Panel Title</label>
            <div class="col-sm-9">
              <input type="text" id="panel-title" name="panelTitle" class="form-control" value="Support Tickets" required>
              <small class="form-text text-muted">Title of the ticket panel embed</small>
            </div>
          </div>

          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Panel Description</label>
            <div class="col-sm-9">
              <textarea id="panel-description" name="panelDescription" class="form-control" rows="3" required>Select an option below to create a support ticket. Our team will assist you as soon as possible.</textarea>
              <small class="form-text text-muted">Description text for the ticket panel</small>
            </div>
          </div>

          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Panel Color</label>
            <div class="col-sm-9">
              <input type="color" id="panel-color" name="panelColor" class="form-control" value="#9b59b6">
              <small class="form-text text-muted">Color for the ticket panel embed</small>
            </div>
          </div>

          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Panel Image (Optional)</label>
            <div class="col-sm-9">
              <input type="url" id="panel-image" name="panelImage" class="form-control" placeholder="https://example.com/image.png">
              <small class="form-text text-muted">Optional image URL for the panel</small>
            </div>
          </div>

          <div class="form-group row">
            <label class="col-sm-3 col-form-label">Ticket Types</label>
            <div class="col-sm-9">
              <button type="button" id="add-ticket-type" class="btn btn-secondary btn-sm mb-2">
                <i class="fas fa-plus"></i> Add Ticket Type
              </button>
              
              <div id="ticket-types-container">
                <!-- First ticket type (default) -->
                <div class="ticket-type-row" data-index="0" style="--row-index: 0;">
                  <div class="row">
                    <div class="col-4">
                      <input type="text" class="form-control type-label" 
                             name="ticketTypes[0][label]" placeholder="Label" value="General Support" required>
                    </div>
                    <div class="col-2">
                      <input type="text" class="form-control type-emoji" 
                             name="ticketTypes[0][emoji]" placeholder="Emoji" value="🔧" required>
                    </div>
                    <div class="col-5">
                      <input type="text" class="form-control type-description" 
                             name="ticketTypes[0][description]" placeholder="Description" value="General questions and support">
                    </div>
                    <div class="col-1">
                      <button type="button" class="btn btn-danger btn-sm remove-ticket-type">
                        <i class="fas fa-times"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="form-buttons">
            <button type="submit" class="btn btn-primary">Create Panel</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Ticket Details Modal -->
<div class="modal fade dark-theme" id="ticket-modal" tabindex="-1" role="dialog" aria-labelledby="ticketModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="ticketModalLabel">Ticket Details</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="ticket-details">
          <div class="row">
            <div class="col-md-6">
              <p><strong>ID:</strong> <span id="modal-ticket-id"></span></p>
              <p><strong>Created By:</strong> <span id="modal-ticket-user"></span></p>
              <p><strong>Type:</strong> <span id="modal-ticket-type"></span></p>
            </div>
            <div class="col-md-6">
              <p><strong>Created:</strong> <span id="modal-ticket-created"></span></p>
              <p><strong>Status:</strong> <span id="modal-ticket-status" class="badge"></span></p>
              <p><strong>Channel ID:</strong> <span id="modal-ticket-channel"></span></p>
            </div>
          </div>
          
          <div class="ticket-content">
            <h6>Ticket Content:</h6>
            <div id="modal-ticket-content" class="p-3 border rounded">
              <p class="text-muted">Loading content...</p>
            </div>
          </div>
          
          <div class="ticket-transcript-section">
            <h6>Transcript:</h6>
            <div id="modal-transcript-preview" class="p-3 border rounded">
              <p class="text-muted">Loading transcript...</p>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" id="download-transcript" class="btn btn-info">
          <i class="fas fa-download"></i> Download Transcript
        </button>
        <button type="button" id="close-ticket" class="btn btn-danger">
          <i class="fas fa-lock"></i> Close Ticket
        </button>
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Close Ticket Confirmation Modal -->
<div class="modal fade dark-theme" id="close-ticket-modal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Close Ticket</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to close this ticket?</p>
        <form id="close-ticket-form">
          <div class="form-group">
            <label for="close-reason">Reason for closing (optional):</label>
            <textarea id="close-reason" class="form-control" rows="3" placeholder="Enter a reason for closing this ticket..."></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="button" id="confirm-close-ticket" class="btn btn-danger">Close Ticket</button>
      </div>
    </div>
  </div>
</div>

