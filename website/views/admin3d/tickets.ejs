<!-- 
  Ticket Management Interface
  Part of the Admin 3D Dashboard
-->
<div class="admin3d-page-header">
  <h1><i class="fas fa-ticket-alt"></i> Ticket Management</h1>
  <p>Manage support tickets across all your Discord servers</p>
</div>

<div class="admin3d-content">
  <!-- Server Selection -->
  <div class="admin3d-card">
    <div class="admin3d-card-header">
      <h2><i class="fas fa-server"></i> Select Server</h2>
      <div class="step-indicators">
        <div class="step active" data-step="1"><i class="fas fa-server"></i></div>
        <div class="step" data-step="2"><i class="fas fa-ticket-alt"></i></div>
        <div class="step" data-step="3"><i class="fas fa-cog"></i></div>
      </div>
    </div>
    <div class="admin3d-card-content">
      <div class="admin3d-form-group">
        <label for="server-select">Choose a Discord Server:</label>
        <select id="server-select" class="admin3d-form-select">
          <option value="" disabled selected>Select a server</option>
          <% if (client && client.guilds) { %>
            <% client.guilds.cache.forEach(guild => { %>
              <option value="<%= guild.id %>"><%= guild.name %> (<%= guild.memberCount %> members)</option>
            <% }); %>
          <% } %>
        </select>
      </div>
    </div>
  </div>

  <!-- Ticket Management Section (hidden initially) -->
  <div id="ticket-section" class="ticket-management-section" style="display: none;">
    <!-- Ticket Analytics -->
    <div class="admin3d-card dashboard-stats">
      <div class="admin3d-card-header">
        <h2><i class="fas fa-chart-pie"></i> Ticket Analytics</h2>
      </div>
      <div class="admin3d-card-content">
        <div class="stats-grid">
          <div class="stat-box">
            <div class="stat-icon">
              <i class="fas fa-ticket-alt"></i>
            </div>
            <div class="stat-content">
              <div class="stat-value" id="total-tickets">0</div>
              <div class="stat-label">Total Tickets</div>
            </div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <i class="fas fa-door-open"></i>
            </div>
            <div class="stat-content">
              <div class="stat-value" id="open-tickets">0</div>
              <div class="stat-label">Open Tickets</div>
            </div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <i class="fas fa-door-closed"></i>
            </div>
            <div class="stat-content">
              <div class="stat-value" id="closed-tickets">0</div>
              <div class="stat-label">Closed Tickets</div>
            </div>
          </div>
          <div class="stat-box">
            <div class="stat-icon">
              <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
              <div class="stat-value" id="avg-response-time">--</div>
              <div class="stat-label">Avg. Response Time</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Ticket List -->
    <div class="admin3d-card tickets-list-card">
      <div class="admin3d-card-header">
        <h2><i class="fas fa-list"></i> Tickets</h2>
        <div class="header-actions">
          <div class="admin3d-form-group">
            <select id="ticket-status-filter" class="admin3d-form-select compact-select">
              <option value="all">All Tickets</option>
              <option value="open">Open</option>
              <option value="closed">Closed</option>
            </select>
          </div>
          <button id="refresh-tickets" class="admin3d-btn admin3d-btn-sm admin3d-btn-primary">
            <i class="fas fa-sync-alt"></i> Refresh
          </button>
        </div>
      </div>
      <div class="admin3d-card-content">
        <div class="tickets-list-header">
          <div class="ticket-id-header">ID</div>
          <div class="ticket-user-header">User</div>
          <div class="ticket-topic-header">Topic</div>
          <div class="ticket-status-header">Status</div>
          <div class="ticket-created-header">Created</div>
          <div class="ticket-actions-header">Actions</div>
        </div>
        <div id="tickets-list" class="tickets-list-body">
          <div class="tickets-loading">
            <div class="spinner"></div>
            <p>Select a server to view tickets</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Configuration Tabs -->
    <div class="admin3d-card tabs-card">
      <div class="admin3d-card-header">
        <h2><i class="fas fa-cog"></i> Configuration</h2>
        <div class="tab-navigation">
          <button class="tab-button active" data-tab="config-tab">Settings</button>
          <button class="tab-button" data-tab="panel-tab">Ticket Panel</button>
        </div>
      </div>
      <div class="admin3d-card-content">
        <div class="tab-content">
          <!-- Ticket Config Tab -->
          <div id="config-tab" class="tab-pane active">
            <form id="ticket-config-form" class="admin3d-form">
              <div class="admin3d-form-row">
                <div class="admin3d-form-group">
                  <label for="category-id">Ticket Category:</label>
                  <select id="category-id" name="categoryId" class="admin3d-form-select">
                    <option value="" selected disabled>Select category</option>
                  </select>
                  <small>Category where ticket channels will be created</small>
                </div>
                <div class="admin3d-form-group">
                  <label for="support-role-id">Support Role:</label>
                  <select id="support-role-id" name="supportRoleId" class="admin3d-form-select">
                    <option value="" selected disabled>Select role</option>
                  </select>
                  <small>Role that can access and manage tickets</small>
                </div>
              </div>
              <div class="admin3d-form-row">
                <div class="admin3d-form-group">
                  <label for="log-channel-id">Log Channel:</label>
                  <select id="log-channel-id" name="logChannelId" class="admin3d-form-select">
                    <option value="" selected disabled>Select channel</option>
                  </select>
                  <small>Channel for ticket creation/closure logs</small>
                </div>
                <div class="admin3d-form-group">
                  <label for="max-tickets">Max Tickets Per User:</label>
                  <input type="number" id="max-tickets" name="maxTickets" class="admin3d-form-input" min="1" max="5" value="1">
                  <small>Maximum open tickets a user can have</small>
                </div>
              </div>
              <div class="admin3d-form-row">
                <div class="admin3d-form-group">
                  <label for="cooldown">Ticket Creation Cooldown:</label>
                  <div class="input-with-suffix">
                    <input type="number" id="cooldown" name="cooldown" class="admin3d-form-input" min="0" value="60">
                    <span class="input-suffix">seconds</span>
                  </div>
                  <small>Time between ticket creations</small>
                </div>
              </div>

              <h3>Advanced Settings</h3>
              <div class="admin3d-form-row">
                <div class="admin3d-form-group checkbox-group">
                  <div class="checkbox-container">
                    <input type="checkbox" id="auto-transcript" name="autoTranscript" checked>
                    <label for="auto-transcript">Auto Transcript</label>
                  </div>
                  <small>Automatically generate transcript when tickets are closed</small>
                </div>
                <div class="admin3d-form-group checkbox-group">
                  <div class="checkbox-container">
                    <input type="checkbox" id="auto-close" name="autoClose">
                    <label for="auto-close">Auto Close Inactive Tickets</label>
                  </div>
                  <small>Automatically close tickets with no activity</small>
                </div>
              </div>

              <div id="auto-close-options" class="nested-settings" style="display: none;">
                <div class="admin3d-form-row">
                  <div class="admin3d-form-group">
                    <label for="inactive-hours">Hours of Inactivity:</label>
                    <div class="input-with-suffix">
                      <input type="number" id="inactive-hours" name="inactiveHours" class="admin3d-form-input" min="1" value="24">
                      <span class="input-suffix">hours</span>
                    </div>
                  </div>
                  <div class="admin3d-form-group">
                    <label for="auto-close-message">Auto Close Message:</label>
                    <input type="text" id="auto-close-message" name="autoCloseMessage" class="admin3d-form-input" placeholder="This ticket has been auto-closed due to inactivity.">
                  </div>
                </div>
              </div>

              <div class="admin3d-form-row">
                <div class="admin3d-form-group checkbox-group">
                  <div class="checkbox-container">
                    <input type="checkbox" id="require-topic" name="requireTopic" checked>
                    <label for="require-topic">Require Topic</label>
                  </div>
                  <small>Require users to specify a topic when creating tickets</small>
                </div>
                <div class="admin3d-form-group checkbox-group">
                  <div class="checkbox-container">
                    <input type="checkbox" id="use-threads" name="useThreads">
                    <label for="use-threads">Use Threads</label>
                  </div>
                  <small>Use threads instead of channels for tickets (experimental)</small>
                </div>
              </div>

              <h3>Message Templates</h3>
              <div class="admin3d-form-group">
                <label for="welcome-message">Welcome Message:</label>
                <textarea id="welcome-message" name="welcomeMessage" class="admin3d-form-textarea" rows="3" placeholder="Welcome to your ticket, {user}! Please describe your issue and a staff member will assist you shortly."></textarea>
                <small>Message sent when a ticket is created. Use {user} for user mention.</small>
              </div>
              <div class="admin3d-form-group">
                <label for="close-message">Close Message:</label>
                <textarea id="close-message" name="closeMessage" class="admin3d-form-textarea" rows="3" placeholder="This ticket has been closed by {closer}. A transcript has been saved."></textarea>
                <small>Message sent when a ticket is closed. Use {closer} for staff mention.</small>
              </div>

              <div class="admin3d-form-actions">
                <button type="submit" class="admin3d-btn admin3d-btn-primary">
                  <i class="fas fa-save"></i> Save Configuration
                </button>
              </div>
            </form>
          </div>

          <!-- Ticket Panel Tab -->
          <div id="panel-tab" class="tab-pane">
            <form id="ticket-panel-form" class="admin3d-form">
              <div class="admin3d-form-row">
                <div class="admin3d-form-group">
                  <label for="panel-channel">Target Channel:</label>
                  <select id="panel-channel" name="channelId" class="admin3d-form-select" required>
                    <option value="" selected disabled>Select channel</option>
                  </select>
                  <small>Channel where the ticket panel will be sent</small>
                </div>
              </div>

              <div class="admin3d-form-group">
                <label for="panel-title">Panel Title:</label>
                <input type="text" id="panel-title" name="panelTitle" class="admin3d-form-input" placeholder="Support Tickets">
              </div>

              <div class="admin3d-form-group">
                <label for="panel-description">Panel Description:</label>
                <textarea id="panel-description" name="panelDescription" class="admin3d-form-textarea" rows="3" placeholder="Need help? Click the button below to create a ticket and our support team will assist you as soon as possible."></textarea>
              </div>

              <div class="admin3d-form-row">
                <div class="admin3d-form-group">
                  <label for="panel-color">Panel Color:</label>
                  <input type="color" id="panel-color" name="panelColor" class="admin3d-form-input" value="#9b59b6">
                </div>
                <div class="admin3d-form-group">
                  <label for="panel-image">Panel Image URL (optional):</label>
                  <input type="url" id="panel-image" name="panelImage" class="admin3d-form-input" placeholder="https://example.com/image.png">
                </div>
              </div>

              <h3>Ticket Types</h3>
              <div class="ticket-types-container">
                <div class="ticket-type-item" data-index="0">
                  <div class="admin3d-form-row">
                    <div class="admin3d-form-group">
                      <label>Label:</label>
                      <input type="text" class="admin3d-form-input ticket-type-label" placeholder="General Support">
                    </div>
                    <div class="admin3d-form-group">
                      <label>Value/ID:</label>
                      <input type="text" class="admin3d-form-input ticket-type-value" placeholder="general">
                    </div>
                    <div class="admin3d-form-group">
                      <label>Emoji (optional):</label>
                      <input type="text" class="admin3d-form-input ticket-type-emoji" placeholder="🔧">
                    </div>
                    <div class="admin3d-form-group form-actions">
                      <button type="button" class="admin3d-btn admin3d-btn-sm admin3d-btn-danger remove-ticket-type">
                        <i class="fas fa-trash"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="admin3d-form-actions">
                <button type="button" id="add-ticket-type" class="admin3d-btn admin3d-btn-secondary">
                  <i class="fas fa-plus"></i> Add Ticket Type
                </button>
              </div>

              <input type="hidden" id="ticket-types-json" name="ticketTypes" value="[]">

              <div class="admin3d-form-actions">
                <button type="submit" class="admin3d-btn admin3d-btn-primary">
                  <i class="fas fa-paper-plane"></i> Send Ticket Panel
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Ticket Info Modal -->
<div id="ticket-info-modal" class="admin3d-modal" data-ticket-id="">
  <div class="admin3d-modal-content">
    <div class="admin3d-modal-header">
      <h3><i class="fas fa-ticket-alt"></i> <span id="ticket-info-id"></span></h3>
      <button class="modal-close"><i class="fas fa-times"></i></button>
    </div>
    <div class="admin3d-modal-body">
      <div class="ticket-info-grid">
        <div class="ticket-info-section">
          <h4>User Information</h4>
          <div class="ticket-user-info">
            <div class="ticket-user-avatar" id="ticket-user-avatar">
              <i class="fas fa-user"></i>
            </div>
            <div class="ticket-user-details">
              <div class="ticket-user-name" id="ticket-user-name">Loading...</div>
              <div class="ticket-user-id" id="ticket-user-id"></div>
            </div>
          </div>
        </div>
        <div class="ticket-info-section">
          <h4>Ticket Details</h4>
          <table class="ticket-details-table">
            <tr>
              <td>Status:</td>
              <td><span id="ticket-info-status" class="ticket-status">Loading...</span></td>
            </tr>
            <tr>
              <td>Created:</td>
              <td id="ticket-info-created">Loading...</td>
            </tr>
            <tr>
              <td>Topic:</td>
              <td id="ticket-info-topic">Loading...</td>
            </tr>
            <tr>
              <td>Channel:</td>
              <td id="ticket-info-channel">Loading...</td>
            </tr>
          </table>
        </div>
      </div>

      <!-- Messages Preview -->
      <div class="ticket-messages-section">
        <h4>Recent Messages</h4>
        <div id="ticket-messages-preview" class="ticket-messages-preview">
          <div class="ticket-message-loading">
            <div class="spinner"></div>
            <p>Loading messages...</p>
          </div>
        </div>
      </div>
    </div>
    <div class="admin3d-modal-footer">
      <button class="admin3d-btn admin3d-btn-secondary" data-action="download-transcript">
        <i class="fas fa-file-download"></i> Download Transcript
      </button>
      <button class="admin3d-btn admin3d-btn-danger" data-action="close-ticket">
        <i class="fas fa-times"></i> Close Ticket
      </button>
      <button class="admin3d-btn admin3d-btn-default" data-action="close-modal">
        <i class="fas fa-times"></i> Close
      </button>
    </div>
  </div>
</div>

<!-- Close Ticket Modal -->
<div id="close-ticket-modal" class="admin3d-modal" data-ticket-id="">
  <div class="admin3d-modal-content">
    <div class="admin3d-modal-header">
      <h3><i class="fas fa-times-circle"></i> Close Ticket</h3>
      <button class="modal-close"><i class="fas fa-times"></i></button>
    </div>
    <div class="admin3d-modal-body">
      <p>Are you sure you want to close this ticket? This action cannot be undone.</p>
      <div class="admin3d-form-group">
        <label for="close-reason">Reason (optional):</label>
        <textarea id="close-reason" class="admin3d-form-textarea" rows="3" placeholder="Enter a reason for closing this ticket..."></textarea>
      </div>
    </div>
    <div class="admin3d-modal-footer">
      <button class="admin3d-btn admin3d-btn-danger" data-action="confirm-close">
        <i class="fas fa-check"></i> Close Ticket
      </button>
      <button class="admin3d-btn admin3d-btn-default" data-action="cancel">
        <i class="fas fa-times"></i> Cancel
      </button>
    </div>
  </div>
</div>

<!-- Custom CSS for the Ticket Management page -->
<style>
/* Ticket Management Specific Styles */

/* Step Indicators */
.step-indicators {
  display: flex;
  gap: 20px;
  align-items: center;
}

.step {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.4);
  color: #888;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  position: relative;
  transition: all 0.3s ease;
  border: 2px solid rgba(137, 54, 255, 0.2);
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
}

.step:not(:last-child)::after {
  content: '';
  position: absolute;
  right: -20px;
  top: 50%;
  transform: translateY(-50%);
  width: 20px;
  height: 2px;
  background-color: rgba(137, 54, 255, 0.2);
}

.step.active {
  background-color: rgba(137, 54, 255, 0.3);
  color: #fff;
  border-color: rgba(137, 54, 255, 0.8);
  box-shadow: 0 0 15px rgba(137, 54, 255, 0.5);
}

.step.active i {
  text-shadow: 0 0 10px rgba(255, 255, 255, 0.7);
}

.step.active:not(:last-child)::after {
  background-color: rgba(137, 54, 255, 0.8);
}

/* Stats Dashboard */
.dashboard-stats {
  margin-bottom: 25px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.stat-box {
  display: flex;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.4);
  border-radius: 10px;
  padding: 15px;
  transition: all 0.3s ease;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(137, 54, 255, 0.2);
}

.stat-box:hover {
  transform: translateY(-3px);
  box-shadow: 0 5px 15px rgba(137, 54, 255, 0.3);
  border-color: rgba(137, 54, 255, 0.5);
}

.stat-icon {
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(137, 54, 255, 0.3), rgba(85, 34, 159, 0.3));
  border-radius: 10px;
  font-size: 22px;
  color: #fff;
  margin-right: 15px;
  box-shadow: 0 0 10px rgba(137, 54, 255, 0.3);
}

.stat-content {
  flex: 1;
}

.stat-value {
  font-size: 24px;
  font-weight: 700;
  color: #fff;
  margin-bottom: 5px;
}

.stat-label {
  font-size: 14px;
  color: #aaa;
}

/* Tickets List */
.tickets-list-card {
  margin-bottom: 25px;
}

.header-actions {
  display: flex;
  gap: 10px;
  align-items: center;
}

.compact-select {
  width: auto;
  min-width: 150px;
}

.tickets-list-header {
  display: grid;
  grid-template-columns: 100px 200px 2fr 100px 180px 120px;
  padding: 10px 15px;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 8px;
  margin-bottom: 10px;
  font-weight: 600;
  color: #ddd;
}

.tickets-list-body {
  max-height: 400px;
  overflow-y: auto;
  padding-right: 5px;
}

.tickets-list-body::-webkit-scrollbar {
  width: 8px;
}

.tickets-list-body::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 10px;
}

.tickets-list-body::-webkit-scrollbar-thumb {
  background: rgba(137, 54, 255, 0.5);
  border-radius: 10px;
}

.tickets-list-body::-webkit-scrollbar-thumb:hover {
  background: rgba(137, 54, 255, 0.7);
}

.ticket-item {
  display: grid;
  grid-template-columns: 100px 200px 2fr 100px 180px 120px;
  padding: 15px;
  background-color: rgba(0, 0, 0, 0.2);
  border-radius: 8px;
  margin-bottom: 10px;
  transition: all 0.2s ease;
  border: 1px solid rgba(255, 255, 255, 0.05);
  align-items: center;
}

.ticket-item:hover {
  background-color: rgba(137, 54, 255, 0.1);
  transform: translateX(3px);
  border-color: rgba(137, 54, 255, 0.3);
}

.ticket-id {
  font-weight: 600;
  color: #fff;
}

.ticket-user {
  display: flex;
  align-items: center;
}

.ticket-user-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  box-shadow: 0 0 10px rgba(137, 54, 255, 0.3);
  overflow: hidden;
}

.ticket-user-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ticket-user-avatar i {
  color: #a970ff;
  font-size: 16px;
}

.ticket-user-name {
  font-weight: 600;
  color: #fff;
  margin-bottom: 3px;
}

.ticket-user-id {
  font-size: 12px;
  color: #aaa;
}

.ticket-topic {
  font-weight: 500;
  color: #ddd;
}

.ticket-status {
  display: inline-block;
  padding: 6px 12px;
  border-radius: 30px;
  font-size: 14px;
  font-weight: 600;
  text-transform: uppercase;
}

.ticket-status.open {
  background-color: rgba(46, 204, 113, 0.2);
  color: #2ecc71;
  border: 1px solid rgba(46, 204, 113, 0.3);
}

.ticket-status.closed {
  background-color: rgba(231, 76, 60, 0.2);
  color: #e74c3c;
  border: 1px solid rgba(231, 76, 60, 0.3);
}

.ticket-created {
  color: #bbb;
  font-size: 14px;
}

.ticket-actions {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
}

.tickets-loading,
.error-message,
.empty-message {
  padding: 30px;
  text-align: center;
  color: #aaa;
}

.spinner {
  margin: 0 auto 15px;
  width: 40px;
  height: 40px;
  border: 4px solid rgba(137, 54, 255, 0.3);
  border-top-color: #a970ff;
  border-radius: 50%;
  animation: spin 1s infinite linear;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.error-message i {
  font-size: 24px;
  color: #e74c3c;
  margin-bottom: 10px;
}

/* Configuration Tabs */
.tabs-card .admin3d-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tab-navigation {
  display: flex;
  gap: 10px;
}

.tab-button {
  padding: 8px 16px;
  background-color: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(137, 54, 255, 0.2);
  border-radius: 8px;
  color: #ddd;
