<%# 
  SWOOSH Bot Simplified Ticket Management
  Clean and Intuitive Design
%>

<style>
  /* Main Container */
  .tickets-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  /* Header */
  .tickets-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 30px;
    text-align: center;
  }

  .tickets-header h1 {
    font-size: 28px;
    margin-bottom: 15px;
    color: #fff;
    text-shadow: 0 0 10px rgba(137, 54, 255, 0.8);
  }

  .tickets-header p {
    font-size: 16px;
    max-width: 600px;
    color: #ccc;
  }

  /* Server Select Section */
  .server-select-section {
    background: rgba(30, 25, 60, 0.7);
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(137, 54, 255, 0.3);
    margin-bottom: 30px;
  }

  .server-select-section h2 {
    font-size: 20px;
    margin-bottom: 15px;
    color: #fff;
    display: flex;
    align-items: center;
  }

  .server-select-section h2 i {
    margin-right: 10px;
    color: rgba(137, 54, 255, 0.9);
  }

  .server-select-wrapper {
    position: relative;
  }

  #server-select {
    width: 100%;
    padding: 15px;
    font-size: 16px;
    background-color: rgba(15, 15, 30, 0.8);
    color: white;
    border: 2px solid rgba(137, 54, 255, 0.5);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    appearance: auto;
    -webkit-appearance: auto;
    -moz-appearance: auto;
  }

  #server-select:hover {
    border-color: rgba(137, 54, 255, 0.8);
    box-shadow: 0 0 15px rgba(137, 54, 255, 0.4);
  }

  #server-select:focus {
    outline: none;
    border-color: rgba(137, 54, 255, 1);
    box-shadow: 0 0 15px rgba(137, 54, 255, 0.7);
  }

  #server-select option {
    background-color: #111;
    color: white;
    padding: 10px;
  }

  /* Main Content Container - Hidden until server is selected */
  #ticket-content {
    display: none;
  }

  /* Tabs Navigation */
  .ticket-tabs {
    display: flex;
    border-bottom: 1px solid rgba(137, 54, 255, 0.3);
    margin-bottom: 20px;
  }

  .ticket-tab {
    padding: 12px 20px;
    font-size: 16px;
    color: #ccc;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ticket-tab.active {
    color: #fff;
    border-bottom-color: rgba(137, 54, 255, 0.9);
    background: rgba(137, 54, 255, 0.1);
  }

  .ticket-tab:hover:not(.active) {
    color: #fff;
    border-bottom-color: rgba(137, 54, 255, 0.5);
    background: rgba(137, 54, 255, 0.05);
  }

  .ticket-tab i {
    margin-right: 8px;
  }

  /* Tab Content */
  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
  }

  /* Card Design */
  .card {
    background: rgba(20, 18, 40, 0.7);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(137, 54, 255, 0.2);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 15px;
    margin-bottom: 15px;
    border-bottom: 1px solid rgba(137, 54, 255, 0.2);
  }

  .card-title {
    font-size: 18px;
    font-weight: 600;
    color: #fff;
    display: flex;
    align-items: center;
  }

  .card-title i {
    margin-right: 10px;
    color: rgba(137, 54, 255, 0.9);
  }

  .card-actions {
    display: flex;
    gap: 10px;
  }

  /* Stats Cards */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 20px;
  }

  .stat-card {
    background: rgba(25, 20, 50, 0.7);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.3s ease;
    border: 1px solid rgba(137, 54, 255, 0.2);
  }

  .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3), 0 0 15px rgba(137, 54, 255, 0.3);
    border-color: rgba(137, 54, 255, 0.5);
  }

  .stat-icon {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(137, 54, 255, 0.2);
    margin-bottom: 15px;
    font-size: 20px;
    color: rgba(137, 54, 255, 0.9);
  }

  .stat-value {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 5px;
    background: linear-gradient(90deg, #8935ff 0%, #c879ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .stat-label {
    font-size: 14px;
    color: #ccc;
  }

  /* Ticket List Table */
  .ticket-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
  }

  .search-bar {
    display: flex;
    align-items: center;
    background: rgba(30, 25, 65, 0.5);
    border-radius: 8px;
    padding: 0 15px;
  }

  .search-bar input {
    background: transparent;
    border: none;
    padding: 10px;
    color: #fff;
    width: 250px;
  }

  .search-bar input:focus {
    outline: none;
  }

  .search-bar i {
    color: #999;
  }

  .filter-button {
    padding: 10px 15px;
    background: rgba(137, 54, 255, 0.2);
    border: 1px solid rgba(137, 54, 255, 0.4);
    border-radius: 8px;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
  }

  .filter-button:hover {
    background: rgba(137, 54, 255, 0.3);
  }

  .ticket-list {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }

  .ticket-list th {
    text-align: left;
    padding: 15px;
    background: rgba(20, 18, 40, 0.7);
    color: #ddd;
    font-weight: 500;
    white-space: nowrap;
  }

  .ticket-list tr {
    border-bottom: 1px solid rgba(137, 54, 255, 0.1);
    transition: all 0.2s ease;
  }

  .ticket-list tr:hover {
    background: rgba(137, 54, 255, 0.05);
  }

  .ticket-list td {
    padding: 15px;
    color: #ccc;
  }

  .ticket-id {
    font-family: monospace;
    font-weight: 600;
    color: #fff;
  }

  .ticket-user {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .user-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(137, 54, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(137, 54, 255, 0.8);
  }

  .user-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .user-details {
    display: flex;
    flex-direction: column;
  }

  .user-name {
    color: #fff;
    font-weight: 500;
  }

  .user-id {
    font-size: 12px;
    color: #999;
  }

  .ticket-status {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
  }

  .status-open {
    background: rgba(0, 200, 100, 0.15);
    color: rgb(0, 200, 100);
  }

  .status-closed {
    background: rgba(255, 75, 100, 0.15);
    color: rgb(255, 100, 120);
  }

  .ticket-actions-cell {
    white-space: nowrap;
    text-align: right;
  }

  .action-btn {
    background: rgba(100, 100, 140, 0.2);
    border: none;
    color: #ccc;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-left: 5px;
  }

  .action-btn:hover {
    background: rgba(137, 54, 255, 0.3);
    color: #fff;
  }

  .action-view {
    background: rgba(100, 130, 255, 0.2);
    color: rgb(100, 130, 255);
  }

  .action-view:hover {
    background: rgba(100, 130, 255, 0.3);
  }

  .action-close {
    background: rgba(255, 75, 100, 0.2);
    color: rgb(255, 100, 120);
  }

  .action-close:hover {
    background: rgba(255, 75, 100, 0.3);
  }

  /* Form Elements */
  .form-group {
    margin-bottom: 20px;
  }

  .form-label {
    display: block;
    margin-bottom: 8px;
    color: #ddd;
    font-size: 15px;
  }

  .form-hint {
    display: block;
    margin-top: 8px;
    color: #999;
    font-size: 13px;
  }

  .form-input {
    width: 100%;
    padding: 12px 15px;
    background: rgba(20, 18, 40, 0.7);
    border: 1px solid rgba(137, 54, 255, 0.3);
    border-radius: 8px;
    color: #fff;
    font-size: 15px;
    transition: all 0.2s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: rgba(137, 54, 255, 0.8);
    box-shadow: 0 0 10px rgba(137, 54, 255, 0.3);
  }

  .form-select {
    width: 100%;
    padding: 12px 15px;
    background: rgba(20, 18, 40, 0.7);
    border: 1px solid rgba(137, 54, 255, 0.3);
    border-radius: 8px;
    color: #fff;
    font-size: 15px;
    transition: all 0.2s ease;
    appearance: auto;
    -webkit-appearance: auto;
    -moz-appearance: auto;
  }

  .form-select:focus {
    outline: none;
    border-color: rgba(137, 54, 255, 0.8);
    box-shadow: 0 0 10px rgba(137, 54, 255, 0.3);
  }

  .form-textarea {
    width: 100%;
    padding: 12px 15px;
    background: rgba(20, 18, 40, 0.7);
    border: 1px solid rgba(137, 54, 255, 0.3);
    border-radius: 8px;
    color: #fff;
    font-size: 15px;
    min-height: 100px;
    resize: vertical;
    transition: all 0.2s ease;
  }

  .form-textarea:focus {
    outline: none;
    border-color: rgba(137, 54, 255, 0.8);
    box-shadow: 0 0 10px rgba(137, 54, 255, 0.3);
  }

  .form-row {
    display: flex;
    gap: 20px;
  }

  .form-row .form-group {
    flex: 1;
  }

  .checkbox-group {
    margin-bottom: 20px;
  }

  .checkbox-wrapper {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
  }

  .checkbox-wrapper input[type="checkbox"] {
    margin-right: 10px;
    width: 18px;
    height: 18px;
    accent-color: rgba(137, 54, 255, 0.8);
  }

  .checkbox-wrapper label {
    color: #ddd;
    font-size: 15px;
  }

  .form-submit {
    padding: 12px 24px;
    background: rgba(137, 54, 255, 0.7);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .form-submit:hover {
    background: rgba(137, 54, 255, 0.9);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(137, 54, 255, 0.3);
  }

  /* Modal */
  .modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(5px);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }

  .modal-overlay.active {
    display: flex;
  }

  .modal-container {
    background: rgba(25, 22, 45, 0.95);
    border-radius: 12px;
    width: 90%;
    max-width: 700px;
    max-height: 90vh;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 20px rgba(137, 54, 255, 0.2);
    border: 1px solid rgba(137, 54, 255, 0.3);
    display: flex;
    flex-direction: column;
  }

  .modal-large {
    max-width: 900px;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background: rgba(30, 25, 60, 0.7);
    border-bottom: 1px solid rgba(137, 54, 255, 0.2);
  }

  .modal-title {
    font-size: 18px;
    font-weight: 600;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .modal-close {
    background: transparent;
    border: none;
    color: #ccc;
    font-size: 20px;
    cursor: pointer;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .modal-body {
    padding: 20px;
    overflow-y: auto;
    max-height: calc(90vh - 130px);
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 15px 20px;
    background: rgba(30, 25, 60, 0.7);
    border-top: 1px solid rgba(137, 54, 255, 0.2);
  }

  .btn {
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 15px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: none;
  }

  .btn-primary {
    background: rgba(137, 54, 255, 0.7);
    color: white;
  }

  .btn-primary:hover {
    background: rgba(137, 54, 255, 0.9);
    box-shadow: 0 0 10px rgba(137, 54, 255, 0.3);
  }

  .btn-secondary {
    background: rgba(100, 100, 130, 0.3);
    color: white;
  }

  .btn-secondary:hover {
    background: rgba(100, 100, 130, 0.5);
  }

  .btn-danger {
    background: rgba(255, 75, 100, 0.7);
    color: white;
  }

  .btn-danger:hover {
    background: rgba(255, 75, 100, 0.9);
    box-shadow: 0 0 10px rgba(255, 75, 100, 0.3);
  }

  .btn-info {
    background: rgba(50, 150, 255, 0.7);
    color: white;
  }

  .btn-info:hover {
    background: rgba(50, 150, 255, 0.9);
    box-shadow: 0 0 10px rgba(50, 150, 255, 0.3);
  }

  /* Ticket Info Modal */
  .ticket-info-header {
    display: flex;
    align-items: center;
    gap: 15px;
    padding-bottom: 20px;
    margin-bottom: 20px;
    border-bottom: 1px solid rgba(137, 54, 255, 0.2);
  }

  .ticket-info-user {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .ticket-info-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(137, 54, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(137, 54, 255, 0.8);
    font-size: 24px;
  }

  .ticket-info-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ticket-info-details {
    display: flex;
    flex-direction: column;
  }

  .ticket-info-name {
    font-size: 18px;
    font-weight: 600;
    color: #fff;
  }

  .ticket-info-id {
    font-size: 14px;
    color: #999;
  }

  .ticket-info-status {
    margin-left: auto;
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 500;
  }

  .ticket-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 25px;
  }

  .ticket-info-item {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .ticket-info-label {
    font-size: 14px;
    color: #999;
  }

  .ticket-info-value {
    font-size: 16px;
    color: #fff;
  }

  .ticket-messages-title {
    font-size: 18px;
    margin-bottom: 15px;
    color: #ddd;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ticket-messages-container {
    background: rgba(20, 18, 40, 0.7);
    border-radius: 12px;
    padding: 15px;
    max-height: 350px;
    overflow-y: auto;
    border: 1px solid rgba(137, 54, 255, 0.2);
  }

  .ticket-message {
    display: flex;
    gap: 12px;
    margin-bottom: 15px;
    padding-bottom: 15px;
    border-bottom: 1px solid rgba(137, 54, 255, 0.1);
  }

  .ticket-message:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .message-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(137, 54, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(137, 54, 255, 0.8);
    flex-shrink: 0;
  }

  .message-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .message-content {
    flex: 1;
  }

  .message-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .message-author {
    font-weight: 500;
    color: #fff;
  }

  .message-time {
    font-size: 13px;
    color: #999;
  }

  .message-text {
    color: #ddd;
    font-size: 15px;
    line-height: 1.5;
  }

  .message-bot {
    background: rgba(137, 54, 255, 0.1);
    padding: 10px;
    border-radius: 10px;
  }

  /* Loading */
  .loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 0;
    color: #999;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 3px solid rgba(137, 54, 255, 0.3);
    border-top-color: rgba(137, 54, 255, 0.9);
    animation: spin 1s linear infinite;
    margin-bottom: 20px;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Responsive */
  @media (max-width: 992px) {
    .form-row {
      flex-direction: column;
      gap: 0;
    }
    
    .stat-card {
      padding: 15px;
    }
    
    .stat-icon {
      width: 40px;
      height: 40px;
      font-size: 16px;
    }
    
    .stat-value {
      font-size: 24px;
    }
  }

  @media (max-width: 768px) {
    .ticket-tabs {
      flex-wrap: wrap;
    }
    
    .ticket-tab {
      flex: 1;
      min-width: 120px;
      text-align: center;
      padding: 10px;
    }
    
    .ticket-toolbar {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    
    .search-bar {
      width: 100%;
    }
    
    .search-bar input {
      width: 100%;
    }
    
    .filter-button {
      width: 100%;
      justify-content: center;
    }
    
    .ticket-list {
      display: block;
    }
    
    .ticket-list thead {
      display: none;
    }
    
    .ticket-list tbody {
      display: block;
    }
    
    .ticket-list tr {
      display: block;
      margin-bottom: 15px;
      border: 1px solid rgba(137, 54, 255, 0.2);
      border-radius: 8px;
      padding: 10px;
    }
    
    .ticket-list td {
      display: block;
      padding: 8px;
      text-align: right;
      position: relative;
      padding-left: 120px;
    }
    
    .ticket-list td::before {
      content: attr(data-label);
      position: absolute;
      left: 8px;
      top: 8px;
      font-weight: 500;
      color: #999;
    }
    
    .ticket-user {
      justify-content: flex-end;
    }
    
    .ticket-actions-cell {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      padding-left: 8px;
    }
    
    .ticket-info-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .ticket-info-status {
      margin-left: 0;
      margin-top: 10px;
    }
  }

  @media (max-width: 576px) {
    .tickets-container {
      padding: 10px;
    }
    
    .stat-card {
      padding: 10px;
    }
    
    .modal-container {
      width: 95%;
    }
    
    .modal-body {
      padding: 15px;
    }
    
    .modal-footer {
      flex-wrap: wrap;
      gap: 5px;
    }
    
    .btn {
      flex: 1;
      justify-content: center;
      padding: 8px;
      font-size: 14px;
    }
  }
</style>

<div class="tickets-container">
  <!-- Header -->
  <div class="tickets-header">
    <h1>Ticket Management</h1>
    <p>Manage support tickets across your Discord servers. View ticket statistics, handle open tickets, and configure your support system settings.</p>
  </div>
  
  <!-- Server Selection -->
  <div class="server-select-section">
    <h2><i class="fas fa-server"></i> Select a Server</h2>
    <div class="server-select-wrapper">
      <select id="server-select">
        <option value="">Click here to select a server</option>
        <% if (client && client.guilds) { %>
          <% client.guilds.cache.sort((a, b) => a.name.localeCompare(b.name)).forEach(guild => { %>
            <option value="<%= guild.id %>"><%= guild.name %> (<%= guild.memberCount %> members)</option>
          <% }); %>
        <% } %>
      </select>
    </div>
  </div>
  
  <!-- Main Ticket Content - Hidden until server is selected -->
  <div id="ticket-content">
    <!-- Tabs Navigation -->
    <div class="ticket-tabs">
      <button class="ticket-tab active" data-tab="overview">
        <i class="fas fa-chart-bar"></i> Overview
      </button>
      <button class="ticket-tab" data-tab="tickets">
        <i class="fas fa-ticket-alt"></i> Tickets
      </button>
      <button class="ticket-tab" data-tab="settings">
        <i class="fas fa-cogs"></i> Settings
      </button>
      <button class="ticket-tab" data-tab="create-panel">
        <i class="fas fa-plus-circle"></i> Create Panel
      </button>
    </div>
    
    <!-- Overview Tab -->
    <div id="overview" class="tab-content active">
      <div class="stats-row">
        <div class="stat-card">
          <div class="stat-icon">
            <i class="fas fa-ticket-alt"></i>
          </div>
          <div class="stat-value" id="total-tickets">0</div>
          <div class="stat-label">Total Tickets</div>
        </div>
        
        <div class="stat-card">
          <div class="stat-icon">
            <i class="fas fa-envelope-open"></i>
          </div>
          <div class="stat-value" id="open-tickets">0</div>
          <div class="stat-label">Open Tickets</div>
        </div>
        
        <div class="stat-card">
          <div class="stat-icon">
            <i class="fas fa-envelope"></i>
          </div>
          <div class="stat-value" id="closed-tickets">0</div>
          <div class="stat-label">Closed Tickets</div>
        </div>
        
        <div class="stat-card">
          <div class="stat-icon">
            <i class="fas fa-clock"></i>
          </div>
          <div class="stat-value" id="avg-response-time">--</div>
          <div class="stat-label">Avg. Response Time</div>
        </div>
      </div>
      
      <div class="card">
        <div class="card-header">
          <div class="card-title">
            <i class="fas fa-ticket-alt"></i> Recent Tickets
          </div>
          <div class="card-actions">
            <button class="btn btn-primary" id="view-all-tickets">
              <i class="fas fa-list"></i> View All
            </button>
          </div>
        </div>
        
        <table class="ticket-list">
          <thead>
            <tr>
              <th width="100">ID</th>
              <th>User</th>
              <th>Topic</th>
              <th width="100">Status</th>
              <th width="150">Created</th>
              <th width="100">Actions</th>
            </tr>
          </thead>
          <tbody id="recent-tickets">
            <!-- Tickets will be loaded here -->
            <tr>
              <td colspan="6">
                <div class="loading-container">
                  <div class="spinner"></div>
                  <p>Loading tickets...</p>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    
    <!-- Tickets Tab -->
    <div id="tickets" class="tab-content">
      <div class="card">
        <div class="card-header">
          <div class="card-title">
            <i class="fas fa-ticket-alt"></i> All Tickets
          </div>
          <div class="card-actions">
            <button class="btn btn-secondary" id="refresh-tickets">
              <i class="fas fa-sync-alt"></i> Refresh
            </button>
          </div>
        </div>
        
        <div class="ticket-toolbar">
          <div class="search-bar">
            <i class="fas fa-search"></i>
            <input type="text" id="ticket-search" placeholder="Search tickets...">
          </div>
          <select class="filter-button" id="ticket-status-filter">
            <option value="all">All Tickets</option>
            <option value="open">Open Tickets</option>
            <option value="closed">Closed Tickets</option>
          </select>
        </div>
        
        <table class="ticket-list">
          <thead>
            <tr>
              <th width="100" data-column="id">ID</th>
              <th data-column="user">User</th>
              <th data-column="topic">Topic</th>
              <th width="100" data-column="status">Status</th>
              <th width="150" data-column="created">Created</th>
              <th width="100">Actions</th>
            </tr>
          </thead>
          <tbody id="tickets-list">
            <!-- Tickets will be loaded here -->
            <tr>
              <td colspan="6">
                <div class="loading-container">
                  <div class="spinner"></div>
                  <p>Loading tickets...</p>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    
    <!-- Settings Tab -->
    <div id="settings" class="tab-content">
      <div class="card">
        <div class="card-header">
          <div class="card-title">
            <i class="fas fa-cogs"></i> Ticket Configuration
          </div>
        </div>
        
        <form id="ticket-config-form">
          <div class="form-group">
            <label class="form-label" for="category-id">Ticket Category</label>
            <select class="form-select" id="category-id" name="categoryId">
              <option value="">Loading categories...</option>
            </select>
            <span class="form-hint">Discord category where ticket channels will be created</span>
          </div>
          
          <div class="form-group">
            <label class="form-label" for="support-role-id">Support Role</label>
            <select class="form-select" id="support-role-id" name="supportRoleId">
              <option value="">Loading roles...</option>
            </select>
            <span class="form-hint">Discord role that will have access to tickets</span>
          </div>
          
          <div class="form-group">
            <label class="form-label" for="log-channel-id">Log Channel</label>
            <select class="form-select" id="log-channel-id" name="logChannelId">
              <option value="">Loading channels...</option>
            </select>
            <span class="form-hint">Discord channel where ticket logs will be sent</span>
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="max-tickets">Max Tickets per User</label>
              <input class="form-input" type="number" id="max-tickets" name="maxTickets" min="1" max="10" value="1">
              <span class="form-hint">Maximum number of open tickets per user</span>
            </div>
            
            <div class="form-group">
              <label class="form-label" for="cooldown">Ticket Cooldown (minutes)</label>
              <input class="form-input" type="number" id="cooldown" name="cooldown" min="0" max="60" value="5">
              <span class="form-hint">Time users must wait between creating tickets</span>
            </div>
          </div>
          
          <div class="checkbox-group">
            <div class="checkbox-wrapper">
              <input type="checkbox" id="auto-transcript" name="autoTranscript" checked>
              <label for="auto-transcript">Generate transcript when closing ticket</label>
            </div>
            
            <div class="checkbox-wrapper">
              <input type="checkbox" id="auto-close" name="autoClose">
              <label for="auto-close">Auto-close inactive tickets</label>
            </div>
            
            <div class="checkbox-wrapper">
              <input type="checkbox" id="require-topic" name="requireTopic" checked>
              <label for="require-topic">Require topic when creating ticket</label>
            </div>
            
            <div class="checkbox-wrapper">
              <input type="checkbox" id="use-threads" name="useThreads">
              <label for="use-threads">Use threads instead of channels (experimental)</label>
            </div>
          </div>
          
          <div id="auto-close-options" style="display: none;">
            <div class="form-group">
              <label class="form-label" for="inactive-hours">Auto-close after inactivity (hours)</label>
              <input class="form-input" type="number" id="inactive-hours" name="inactiveHours" min="1" max="168" value="24">
              <span class="form-hint">Hours of inactivity before auto-closing a ticket</span>
            </div>
            
            <div class="form-group">
              <label class="form-label" for="auto-close-message">Auto-close message</label>
              <textarea class="form-textarea" id="auto-close-message" name="autoCloseMessage" placeholder="This ticket has been closed due to inactivity."></textarea>
              <span class="form-hint">Message sent when auto-closing a ticket</span>
            </div>
          </div>
          
          <div class="form-group">
            <label class="form-label" for="welcome-message">Welcome Message</label>
            <textarea class="form-textarea" id="welcome-message" name="welcomeMessage" placeholder="Thanks for creating a ticket! Please describe your issue and someone will assist you soon."></textarea>
            <span class="form-hint">First message sent when a ticket is created</span>
          </div>
          
          <div class="form-group">
            <label class="form-label" for="close-message">Close Message</label>
            <textarea class="form-textarea" id="close-message" name="closeMessage" placeholder="This ticket has been closed. A transcript will be generated if enabled."></textarea>
            <span class="form-hint">Message sent when closing a ticket</span>
          </div>
          
          <button type="submit" class="form-submit">
            <i class="fas fa-save"></i> Save Configuration
          </button>
        </form>
      </div>
    </div>
    
    <!-- Create Panel Tab -->
    <div id="create-panel" class="tab-content">
      <div class="card">
        <div class="card-header">
          <div class="card-title">
            <i class="fas fa-plus-circle"></i> Create Ticket Panel
          </div>
        </div>
        
        <form id="ticket-panel-form">
          <div class="form-group">
            <label class="form-label" for="panel-channel">Channel</label>
            <select class="form-select" id="panel-channel" name="channelId" required>
              <option value="">Loading channels...</option>
            </select>
            <span class="form-hint">Discord channel where the ticket panel will be sent</span>
          </div>
          
          <div class="form-group">
            <label class="form-label" for="panel-title">Title</label>
            <input class="form-input" type="text" id="panel-title" name="title" placeholder="Support Tickets" value="Support Tickets">
            <span class="form-hint">Title of the ticket panel embed</span>
          </div>
          
          <div class="form-group">
            <label class="form-label" for="panel-description">Description</label>
            <textarea class="form-textarea" id="panel-description" name="description" placeholder="Click the button below to create a support ticket.">Need help? Click the button below to create a support ticket.</textarea>
            <span class="form-hint">Description text of the ticket panel</span>
          </div>
          
          <div class="form-group">
            <label class="form-label" for="panel-button">Button Label</label>
            <input class="form-input" type="text" id="panel-button" name="buttonLabel" placeholder="Create Ticket" value="Create Ticket">
            <span class="form-hint">Text displayed on the button</span>
          </div>
          
          <button type="submit" class="form-submit">
            <i class="fas fa-paper-plane"></i> Send Ticket Panel
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Ticket Info Modal -->
<div class="modal-overlay" id="ticket-info-modal">
  <div class="modal-container modal-large">
    <div class="modal-header">
      <h3 class="modal-title"><i class="fas fa-ticket-alt"></i> Ticket Details</h3>
      <button class="modal-close"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <!-- User Information and Status -->
      <div class="ticket-info-header">
        <div class="ticket-info-user">
          <div class="ticket-info-avatar" id="ticket-info-avatar">
            <i class="fas fa-user"></i>
          </div>
          <div class="ticket-info-details">
            <div class="ticket-info-name" id="ticket-info-name">User#0000</div>
            <div class="ticket-info-id" id="ticket-info-id">000000000000000000</div>
          </div>
        </div>
        <div class="ticket-info-status status-open" id="ticket-info-status">Open</div>
      </div>
      
      <!-- Ticket Details -->
      <div class="ticket-info-grid">
        <div class="ticket-info-item">
          <div class="ticket-info-label">Ticket ID</div>
          <div class="ticket-info-value" id="ticket-info-ticket-id">TICKET-0000</div>
