    /**
     * Handle close ticket
     */
    async function handleCloseTicket() {
      const ticketId = closeTicketModal.getAttribute('data-ticket-id');
      
      if (!ticketId) {
        showNotification('error', 'Error', 'Invalid ticket ID');
        return;
      }
      
      // Get reason
      const reason = document.getElementById('close-reason').value;
      
      // Disable button
      const confirmButton = document.querySelector('[data-action="confirm-close"]');
      confirmButton.disabled = true;
      confirmButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Closing...';
      
      try {
        // Submit close request
        const response = await fetch(`/api/v2/servers/${currentServerId}/tickets/${ticketId}/close`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ reason })
        });
        
        const data = await response.json();
        
        if (!data.success) {
          throw new Error(data.message || 'Failed to close ticket');
        }
        
        // Update ticket in local list
        const ticketIndex = tickets.findIndex(t => t.id === ticketId);
        if (ticketIndex !== -1) {
          tickets[ticketIndex].status = 'Closed';
        }
        
        // Close modals
        closeAllModals();
        
        // Refresh tickets
        loadTickets();
        
        showNotification('success', 'Success', 'Ticket closed successfully');
      } catch (error) {
        console.error('Error closing ticket:', error);
        showNotification('error', 'Error', `Failed to close ticket: ${error.message}`);
      } finally {
        // Re-enable button
        confirmButton.disabled = false;
        confirmButton.innerHTML = '<i class="fas fa-check"></i> Close Ticket';
      }
    }
    
    /**
     * Download ticket transcript
     * @param {string} ticketId - Ticket ID
