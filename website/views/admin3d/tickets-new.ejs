        <div class="ticket-info-item">
          <div class="ticket-info-label">Created</div>
          <div class="ticket-info-value" id="ticket-info-created">2023-01-01</div>
        </div>
        
        <div class="ticket-info-item">
          <div class="ticket-info-label">Topic</div>
          <div class="ticket-info-value" id="ticket-info-topic">Support request</div>
        </div>
        
        <div class="ticket-info-item">
          <div class="ticket-info-label">Channel</div>
          <div class="ticket-info-value" id="ticket-info-channel">#ticket-0000</div>
