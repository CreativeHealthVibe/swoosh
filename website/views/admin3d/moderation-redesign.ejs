<%# 
  SWOOSH Bot 3D Admin Dashboard
  Premium Edition - Complete Redesign
  
  Modernized moderation management interface with sidebar layout
%>

<div class="admin3d-moderation">
  <!-- Page header -->
  <div class="mod-header">
    <h1 class="mod-title">Command Center</h1>
    <div class="mod-header-actions">
      <span class="username"><i class="fas fa-user-shield"></i> <%= user.username %></span>
    </div>
  </div>
  
  <!-- Sidebar Navigation -->
  <div class="mod-sidebar">
    <!-- Server selector -->
    <div class="mod-server-selector">
      <div class="server-selector-wrapper">
        <select id="serverSelect">
          <option value="">Select a server</option>
          <% if (servers && servers.length > 0) { %>
            <% servers.forEach(server => { %>
              <option value="<%= server.id %>"><%= server.name %></option>
            <% }); %>
          <% } else { %>
            <option disabled>No servers available</option>
          <% } %>
        </select>
      </div>
    </div>
    
    <!-- Emergency button -->
    <div class="emergency-tools">
      <a href="/admin3d/moderation-emergency" class="emergency-link">
        <i class="fas fa-exclamation-triangle"></i> Emergency Tools
      </a>
    </div>
    
    <!-- Sidebar Nav Tabs -->
    <div class="mod-nav-tabs">
      <button class="mod-nav-btn active" data-tab="ban-management">
        <i class="fas fa-gavel"></i> Ban Management
      </button>
      <button class="mod-nav-btn" data-tab="warning-system">
        <i class="fas fa-exclamation-triangle"></i> Warning System
      </button>
      <button class="mod-nav-btn" data-tab="auto-moderation">
        <i class="fas fa-shield-alt"></i> Auto-Moderation
      </button>
      <button class="mod-nav-btn" data-tab="advanced-filters">
        <i class="fas fa-filter"></i> Advanced Filters
      </button>
    </div>
  </div>
  
  <!-- Content Container -->
  <div class="mod-content-container" id="moderation-tabs">
    <!-- Stats Cards -->
    <div class="mod-stats-cards">
      <div class="mod-stat-card">
        <div class="mod-stat-icon ban-icon">
          <i class="fas fa-gavel"></i>
        </div>
        <div class="mod-stat-content">
          <h3 id="totalBans">0</h3>
          <span>Active Bans</span>
        </div>
      </div>
      
      <div class="mod-stat-card">
        <div class="mod-stat-icon warning-icon">
          <i class="fas fa-exclamation-triangle"></i>
        </div>
        <div class="mod-stat-content">
          <h3 id="totalWarnings">0</h3>
          <span>Active Warnings</span>
        </div>
      </div>
      
      <div class="mod-stat-card">
        <div class="mod-stat-icon shield-icon">
          <i class="fas fa-shield-alt"></i>
        </div>
        <div class="mod-stat-content">
          <h3 id="automodActions">0</h3>
          <span>AutoMod Actions</span>
        </div>
      </div>
      
      <div class="mod-stat-card">
        <div class="mod-stat-icon member-icon">
          <i class="fas fa-users"></i>
        </div>
        <div class="mod-stat-content">
          <h3 id="memberCount">0</h3>
          <span>Total Members</span>
        </div>
      </div>
    </div>
    
    <!-- Tab Content -->
    <div class="tab-content-container">
      <!-- Ban Management Tab -->
      <div id="ban-management" class="tab-content active">
        <div class="mod-section">
          <!-- Left section: Ban User -->
          <div class="mod-ban-user">
            <div class="mod-section-header">
              <div class="mod-section-icon ban-icon">
                <i class="fas fa-user-slash"></i>
              </div>
              <h3>Ban User</h3>
              <div class="mod-premium-badge">
                <span>ULTRA</span>
              </div>
            </div>
            <div class="mod-section-content">
              <p class="mod-desc">Ban a user from your server with customizable options.</p>
              
              <!-- Ban User Form with Direct Submission -->
              <form action="/admin3d/direct-bans/ban-user" method="POST" id="banUserForm">
                <input type="hidden" id="banServerId" name="serverId" value="">
                
                <div class="form-field">
                  <label for="userId">User ID or @Mention</label>
                  <input type="text" id="userId" name="userId" placeholder="Enter user ID or @mention" required>
                </div>
                
                <div class="form-field">
                  <label for="banReason">Reason</label>
                  <textarea id="banReason" name="reason" placeholder="Explain the reason for this ban..." required rows="3"></textarea>
                </div>
                
                <div class="form-row">
                  <div class="form-field">
                    <label for="banDuration">Duration</label>
                    <select id="banDuration" name="duration">
                      <option value="permanent">Permanent</option>
                      <option value="1d">1 Day</option>
                      <option value="3d">3 Days</option>
                      <option value="7d">1 Week</option>
                      <option value="14d">2 Weeks</option>
                      <option value="30d">1 Month</option>
                      <option value="custom">Custom...</option>
                    </select>
                  </div>
                </div>
                
                <!-- Custom Duration Input (hidden by default) -->
                <div id="customDurationGroup" class="form-field" style="display: none;">
                  <label for="customDuration">Custom Duration</label>
                  <div class="custom-duration-inputs">
                    <input type="number" id="customDuration" name="customDuration" min="1" value="1">
                    <select id="customDurationUnit" name="customDurationUnit">
                      <option value="h">Hours</option>
                      <option value="d" selected>Days</option>
                      <option value="w">Weeks</option>
                      <option value="m">Months</option>
                    </select>
                  </div>
                </div>
                
                <div class="form-options">
                  <div class="form-check">
                    <input type="checkbox" id="deleteMessages" name="deleteMessages" value="true">
                    <label for="deleteMessages">Delete recent messages</label>
                  </div>
                  
                  <div class="form-check">
                    <input type="checkbox" id="addToBlacklist" name="addToBlacklist" value="true">
                    <label for="addToBlacklist">Add to blacklist</label>
                  </div>
                </div>
                
                <div class="form-actions">
                  <button type="submit" class="mod-btn danger-btn" id="banUserBtn">
                    <i class="fas fa-gavel"></i> Ban User
                  </button>
                </div>
              </form>
            </div>
          </div>
          
          <!-- Right section: Current Bans -->
          <div class="mod-current-bans">
            <div class="mod-section-header">
              <div class="mod-section-icon list-icon">
                <i class="fas fa-list"></i>
              </div>
              <h3>Current Bans</h3>
              <div class="mod-refresh-btn" id="refreshBans">
                <i class="fas fa-sync-alt"></i>
              </div>
            </div>
            <div class="mod-section-content">
              <!-- Ban List Search -->
              <div class="admin3d-search-filters">
                <div class="admin3d-search-box">
                  <i class="fas fa-search"></i>
                  <input type="text" id="banSearchInput" placeholder="Search bans...">
                </div>
              </div>
              
              <!-- Ban List Table -->
              <div class="admin3d-table-wrapper">
                <table class="admin3d-table">
                  <thead>
                    <tr>
                      <th>User</th>
                      <th>Reason</th>
                      <th>Date</th>
                      <th>Duration</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="banListBody">
                    <tr class="empty-state">
                      <td colspan="5">
                        <div class="empty-state-message">
                          <i class="fas fa-info-circle"></i>
                          <p>Select a server to view ban list</p>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Warning System Tab -->
      <div id="warning-system" class="tab-content">
        <div class="mod-section">
          <!-- Issue Warning Form -->
          <div class="mod-warn-user">
            <div class="mod-section-header">
              <div class="mod-section-icon warning-icon">
                <i class="fas fa-exclamation-triangle"></i>
              </div>
              <h3>Issue Warning</h3>
              <div class="mod-premium-badge">
                <span>ULTRA</span>
              </div>
            </div>
            <div class="mod-section-content">
              <p class="mod-desc">Issue a warning to a user in the selected server. Warnings will be tracked and can be used for automated moderation.</p>
              <form id="warnUserForm" action="/admin3d/warnings/add" method="POST">
                <input type="hidden" id="warnServerId" name="serverId">
                
                <div class="form-field">
                  <label for="warnUserId">User ID or @mention</label>
                  <input type="text" id="warnUserId" name="userId" placeholder="Enter user ID or @mention" required>
                </div>
                
                <div class="form-field">
                  <label for="warnReason">Warning Reason</label>
                  <textarea id="warnReason" name="reason" placeholder="Explain the reason for this warning..." required rows="3"></textarea>
                </div>
                
                <div class="form-options">
                  <div class="form-check">
                    <input type="checkbox" id="notifyUser" name="notifyUser" checked>
                    <label for="notifyUser">Notify user via DM</label>
                  </div>
                </div>
                
                <div class="form-actions">
                  <button type="submit" class="mod-btn danger-btn">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>Issue Warning</span>
                  </button>
                </div>
              </form>
            </div>
          </div>
          
          <!-- Warning List -->
          <div class="mod-current-warnings">
            <div class="mod-section-header">
              <div class="mod-section-icon list-icon">
                <i class="fas fa-list"></i>
              </div>
              <h3>Warning History</h3>
              <div id="refreshWarnings" class="mod-refresh-btn" title="Refresh warnings list">
                <i class="fas fa-sync-alt"></i>
              </div>
            </div>
            <div class="mod-section-content">
              <div class="admin3d-search-filters">
                <div class="admin3d-search-box">
                  <i class="fas fa-search"></i>
                  <input type="text" id="warningSearchInput" placeholder="Search warnings...">
                </div>
              </div>
              
              <div class="admin3d-table-wrapper">
                <table class="admin3d-table">
                  <thead>
                    <tr>
                      <th>User</th>
                      <th>Reason</th>
                      <th>Date</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="warningListBody">
                    <tr class="empty-state">
                      <td colspan="5">
                        <div class="empty-state-message">
                          <i class="fas fa-info-circle"></i>
                          <p>Please select a server to view warnings</p>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Warning Statistics and Management -->
        <div class="mod-warning-stats-container">
          <div class="warning-stats-grid">
            <div class="warning-stat-item">
              <div class="warning-stat-value" id="totalServerWarnings">-</div>
              <div class="warning-stat-label">Total Warnings</div>
            </div>
            <div class="warning-stat-item">
              <div class="warning-stat-value" id="activeWarnings">-</div>
              <div class="warning-stat-label">Active Warnings</div>
            </div>
            <div class="warning-stat-item">
              <div class="warning-stat-value" id="warnedUsers">-</div>
              <div class="warning-stat-label">Warned Users</div>
            </div>
            <div class="warning-stat-item">
              <div class="warning-stat-value" id="avgWarningsPerUser">-</div>
              <div class="warning-stat-label">Avg. Per User</div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Auto-Moderation Tab -->
      <div id="auto-moderation" class="tab-content">
        <div class="mod-section">
          <!-- Auto-Mod Settings -->
          <div class="mod-automod-settings">
            <div class="mod-section-header">
              <div class="mod-section-icon shield-icon">
                <i class="fas fa-shield-alt"></i>
              </div>
              <h3>Auto-Moderation Settings</h3>
              <div class="mod-premium-badge">
                <span>ULTRA</span>
              </div>
            </div>
            <div class="mod-section-content">
              <p class="mod-desc">Configure automatic moderation for your server. These settings will be applied to all new messages.</p>
              
              <form id="automodSettingsForm" action="/admin3d/moderation/automod-settings" method="POST">
                <input type="hidden" id="automodServerId" name="serverId" value="">
                
                <div class="form-options">
                  <div class="form-check">
                    <input type="checkbox" id="enableAutomod" name="enableAutomod">
                    <label for="enableAutomod">Enable Auto-Moderation</label>
                  </div>
                  
                  <div class="form-check">
                    <input type="checkbox" id="logActions" name="logActions">
                    <label for="logActions">Log moderation actions</label>
                  </div>
                </div>
                
                <div class="form-field">
                  <label for="logChannel">Log Channel</label>
                  <select id="logChannel" name="logChannel">
                    <option value="">Select a channel</option>
                  </select>
                </div>
                
                <h4 class="settings-section-title">Content Filters</h4>
                
                <div class="form-options">
                  <div class="form-check">
                    <input type="checkbox" id="filterProfanity" name="filterProfanity">
                    <label for="filterProfanity">Filter profanity</label>
                  </div>
                  
                  <div class="form-check">
                    <input type="checkbox" id="filterLinks" name="filterLinks">
                    <label for="filterLinks">Filter links</label>
                  </div>
                  
                  <div class="form-check">
                    <input type="checkbox" id="filterInvites" name="filterInvites">
                    <label for="filterInvites">Filter Discord invites</label>
                  </div>
                  
                  <div class="form-check">
                    <input type="checkbox" id="filterMassMentions" name="filterMassMentions">
                    <label for="filterMassMentions">Filter mass mentions</label>
                  </div>
                </div>
                
                <div class="form-actions">
                  <button type="submit" class="mod-btn">
                    <i class="fas fa-save"></i> Save Settings
                  </button>
                </div>
              </form>
            </div>
          </div>
          
          <!-- Auto-Mod Logs -->
          <div class="mod-automod-logs">
            <div class="mod-section-header">
              <div class="mod-section-icon list-icon">
                <i class="fas fa-history"></i>
              </div>
              <h3>Auto-Moderation Logs</h3>
              <div id="refreshAutomodLogs" class="mod-refresh-btn" title="Refresh automod logs">
                <i class="fas fa-sync-alt"></i>
              </div>
            </div>
            <div class="mod-section-content">
              <div class="admin3d-search-filters">
                <div class="admin3d-search-box">
                  <i class="fas fa-search"></i>
                  <input type="text" id="automodSearchInput" placeholder="Search automod logs...">
                </div>
              </div>
              
              <div class="admin3d-table-wrapper">
                <table class="admin3d-table">
                  <thead>
                    <tr>
                      <th>User</th>
                      <th>Action</th>
                      <th>Trigger</th>
                      <th>Date</th>
                      <th>Details</th>
                    </tr>
                  </thead>
                  <tbody id="automodLogsBody">
                    <tr class="empty-state">
                      <td colspan="5">
                        <div class="empty-state-message">
                          <i class="fas fa-info-circle"></i>
                          <p>Please select a server to view automod logs</p>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Advanced Filters Tab -->
      <div id="advanced-filters" class="tab-content">
        <div class="filter-builder">
          <div class="filter-builder-header">
            <h4>Custom Filter Builder</h4>
          </div>
          
          <form id="filterBuilderForm" action="/admin3d/moderation/save-filter" method="POST">
            <input type="hidden" id="filterServerId" name="serverId" value="">
            
            <div class="form-field">
              <label for="filterType">Filter Type</label>
              <select id="filterType" name="filterType">
                <option value="keyword">Keyword or Phrase</option>
                <option value="regex">Regular Expression</option>
                <option value="wildcard">Wildcard Pattern</option>
              </select>
            </div>
            
            <div class="form-field">
              <label for="filterContent">Filter Content</label>
              <textarea id="filterContent" name="filterContent" placeholder="Enter keywords, regex, or wildcard pattern" required rows="3"></textarea>
            </div>
            
            <div class="form-field">
              <label for="filterAction">Action</label>
              <select id="filterAction" name="filterAction">
                <option value="delete">Delete Message</option>
                <option value="warn">Warn User</option>
                <option value="timeout">Timeout User (10 min)</option>
                <option value="kick">Kick User</option>
                <option value="ban">Ban User</option>
              </select>
            </div>
            
            <div class="form-actions">
              <button type="submit" class="mod-btn">
                <i class="fas fa-plus"></i> Add Filter
              </button>
            </div>
          </form>
        </div>
        
        <div class="mod-filters-list">
          <div class="mod-section-header">
            <div class="mod-section-icon list-icon">
              <i class="fas fa-filter"></i>
            </div>
            <h3>Custom Filters</h3>
            <div id="refreshFilters" class="mod-refresh-btn" title="Refresh filters">
              <i class="fas fa-sync-alt"></i>
            </div>
          </div>
          <div class="mod-section-content">
            <div class="admin3d-table-wrapper">
              <table class="admin3d-table">
                <thead>
                  <tr>
                    <th>Type</th>
                    <th>Content</th>
                    <th>Action</th>
                    <th>Manage</th>
                  </tr>
                </thead>
                <tbody id="filtersListBody">
                  <tr class="empty-state">
                    <td colspan="4">
                      <div class="empty-state-message">
                        <i class="fas fa-info-circle"></i>
                        <p>Please select a server to view custom filters</p>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- 3D Visualization Container -->
  <div id="moderation-three-container" class="moderation-three-container"></div>
  
  <!-- THREE.js library loading with fallbacks -->
  <script>
    // THREE.js loader with multiple CDN fallbacks
    function loadThreeJS() {
      const sources = [
        'https://cdn.jsdelivr.net/npm/three@0.151.0/build/three.min.js',
        'https://cdnjs.cloudflare.com/ajax/libs/three.js/151/three.min.js',
        'https://unpkg.com/three@0.151.0/build/three.min.js'
      ];
      
      function tryLoad(index) {
        if (index >= sources.length) {
          console.warn('THREE.js not loaded! Falling back to 2D mode.');
          // Tell the visualization to use 2D mode
          window.threeJSLoaded = false;
          return;
        }
        
        const script = document.createElement('script');
        script.src = sources[index];
        script.onload = function() {
          console.log(`THREE.js loaded successfully from ${sources[index]}`);
          window.threeJSLoaded = true;
        };
        script.onerror = function() {
          console.warn(`Failed to load THREE.js from ${sources[index]}`);
          document.body.removeChild(script);
          tryLoad(index + 1);
        };
        document.body.appendChild(script);
      }
      
      // Start trying to load THREE.js
      tryLoad(0);
    }
    
    // Load THREE.js when the page loads
    document.addEventListener('DOMContentLoaded', loadThreeJS);
  </script>
</div>